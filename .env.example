# ── AgriConnect KE — Environment Template ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Server
PORT=3000
NODE_ENV=development

# MySQL Database (Smart_Kilimo)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=Smart_Kilimo
DB_DIALECT=mysql

# Shamba Records Market Prices API
SHAMBA_API_BASE_URL=https://api-data.shambarecords.com/api/v1
SHAMBA_PUBLIC_KEY=sr_pub_your_key_here
SHAMBA_SECRET_KEY=sr_sec_your_key_here
# Auth
# ⚠️ Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret

# CORS (comma-separated origins in production, e.g. https://app.agriconnect.co.ke)
CORS_ORIGIN=*

# ── Optional integrations (Sprint 4+) ───────────────────────────────
# M-Pesa Daraja API (sandbox first)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=

# Africa's Talking SMS (OTP)
# AT_API_KEY=
# AT_USERNAME=

# Cloudinary (images)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── WhatsApp Business Cloud API (phone verification & messaging) ──────
# Obtain these from the Meta for Developers dashboard:
#   https://developers.facebook.com/docs/whatsapp/cloud-api
# WHATSAPP_ACCESS_TOKEN — permanent access token for your WhatsApp Business Account
# WHATSAPP_PHONE_NUMBER_ID — the phone-number-id of your WhatsApp Business profile
# WHATSAPP_VERSION — Graph API version (default: v19.0)
# WHATSAPP_TEMPLATE_NAME — message template name approved by Meta (default: verify_code)
# WHATSAPP_BUSINESS_PHONE — your business WhatsApp number shown to users (e.g. +254700000000)
# Set WHATSAPP_BUSINESS_PHONE to display your WhatsApp number on the phone-verification page.
WHATSAPP_BUSINESS_PHONE=+254700000000
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERSION=
# WHATSAPP_TEMPLATE_NAME=