# AgriConnect Mobile — Environment template
# Copy to `.env` (or rely on app.json "extra.apiUrl"). EXPO_PUBLIC_* vars are
# embedded at build time and are safe to ship (they are not server secrets).

# Base URL of the AgriConnect backend.
# Android emulator uses 10.0.2.2 to reach the host machine.
# iOS simulator can use localhost. A physical device needs your LAN IP, e.g.
#   http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
