-<!-- ══════════════════════════════════════════════════════════════
     APP SIDEBAR (AgriConnect KE Rail)
     --------------------------------------------------------------
     • Solid structural width (260px / w-64), deep charcoal/slate panel
     • Vertical layout: Brand → Profile Card → Navigation Groups → Footer
     • Accessible contrast text: Off-white/slate identity text
     • Handles mobile drawer state and desktop collapse persistence cleanly
     ══════════════════════════════════════════════════════════════ -->
<%
  const navId = (typeof activeNav !== 'undefined' && activeNav)
    ? activeNav
    : (typeof currentPage === 'string' ? currentPage : '');

  const isAuthed = typeof user !== 'undefined' && user;
  const role = isAuthed ? String(user.role || '') : '';
  const displayName = isAuthed ? (user.fullName || user.full_name || 'User') : '';
  const initial = displayName ? displayName.charAt(0).toUpperCase() : '?';
  const roleLabel = role === 'farmer' ? 'Farmer'
    : role === 'buyer' ? 'Buyer'
    : role === 'provider' ? 'Service Provider'
    : role === 'admin' ? 'Administrator'
    : role || 'Guest';

  const userCounty = (isAuthed && user.county) ? user.county : 'Kiambu';

  /* Helper to render navigation items */
  const link = (key, href, tooltip) =>
    `href="${href}" data-tooltip="${tooltip}" class="sidebar-link${navId === key ? ' active' : ''}"` +
    (navId === key ? ' aria-current="page"' : '');
%>

<!-- Mobile drawer toggle + backdrop scrim -->
<button class="sidebar-toggle" id="sidebarToggle" type="button"
        aria-label="Open navigation menu" aria-expanded="false" aria-controls="dashSidebar">
  <span class="sidebar-toggle-open"><i data-lucide="menu" aria-hidden="true"></i></span>
  <span class="sidebar-toggle-close"><i data-lucide="x" aria-hidden="true"></i></span>
</button>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="dash-sidebar" id="dashSidebar" aria-label="Application">

  <!-- ── Brand ─────────────────────────────────────────────────── -->
  <div class="sidebar-brand">
    <a href="/dashboard" class="sidebar-brand-logo" aria-label="AgriConnect KE — go to dashboard">
      <span class="sidebar-brand-mark"><i data-lucide="leaf" aria-hidden="true"></i></span>
      <span class="sidebar-brand-text">Agri<em>Connect</em></span>
    </a>
  </div>

  <!-- ── Identity card ───────────────────────────────────────── -->
  <div class="rail-identity" style="padding: 1rem; margin: 0.5rem 0.75rem; border-radius: 0.75rem; background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="rail-identity-row" style="display: flex; align-items: center; gap: 0.75rem;">
      <span class="rail-avatar" style="width: 38px; height: 38px; border-radius: 50%; background: #059669; color: #ffffff; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 1rem; shrink: 0;"><%= initial %></span>
      <div class="rail-identity-text" style="display: flex; flex-direction: column; overflow: hidden;">
        <span class="rail-profile-name" style="font-weight: 600; color: #f8fafc; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= displayName %>"><%= displayName %></span>
        <span class="rail-role" style="font-size: 0.75rem; color: #cbd5e1; font-weight: 500;"><%= roleLabel %></span>
      </div>
    </div>
    <div style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: #fbbf24; background: rgba(251, 191, 36, 0.1); padding: 0.2rem 0.5rem; border-radius: 0.375rem; width: fit-content;">
      <i data-lucide="map-pin" style="width: 12px; height: 12px;"></i>
      <span><%= userCounty %></span>
    </div>
  </div>

            <!-- ── Navigation ────────────────────────────────────────────── -->
  <% const unreadMsg = (Object.keys(locals).includes("unreadMessagesCount") && locals.unreadMessagesCount) ? locals.unreadMessagesCount : 0; %>
  <% const unreadNotif = (Object.keys(locals).includes("unreadNotificationsCount") && locals.unreadNotificationsCount) ? locals.unreadNotificationsCount : 0; %>
  <% const pendingOrders = (Object.keys(locals).includes("pendingOrdersCount") && locals.pendingOrdersCount) ? locals.pendingOrdersCount : 0; %>

  <nav class="sidebar-nav" aria-label="Primary navigation">

    <div class="rail-group">
      <p class="rail-group-label" id="grp-core">Core</p>
      <a <%- link('dashboard', '/dashboard', 'Dashboard') %>>
        <span class="sidebar-link-icon"><i data-lucide="layout-dashboard" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">Dashboard</span>
      </a>
    </div>

    <div class="rail-group">
      <p class="rail-group-label" id="grp-market">Marketplace</p>
      <a <%- link('marketplace', '/marketplace', 'Marketplace') %>>
        <span class="sidebar-link-icon"><i data-lucide="store" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">Marketplace</span>
      </a>
      <a <%- link('services', '/services', 'Services') %>>
        <span class="sidebar-link-icon"><i data-lucide="tractor" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">Services</span>
      </a>
      <a <%- link('market-prices', '/market-prices', 'Market Prices') %>>
        <span class="sidebar-link-icon"><i data-lucide="bar-chart-2" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">Market Prices</span>
      </a>
    </div>

    <div class="rail-group">
      <p class="rail-group-label" id="grp-ops">Operations</p>
      <a <%- link('orders', '/orders', 'Orders') %>>
        <span class="sidebar-link-icon"><i data-lucide="shopping-bag" aria-hidden="true"></i></span>
                <span class="sidebar-link-text">Orders</span>
        <span class="sidebar-badge sidebar-badge-green" style="<%= pendingOrders > 0 ? '' : 'display:none;' %>"><%= pendingOrders %></span>
      </a>
      <% if (role === 'farmer') { %>
      <a <%- link('produce', '/produce', 'My Produce') %>>
        <span class="sidebar-link-icon"><i data-lucide="box" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">My Produce</span>
      </a>
      <% } %>
      <% if (role === 'provider') { %>
      <a <%- link('requests', '/services/requests/mine', 'Service Requests') %>>
        <span class="sidebar-link-icon"><i data-lucide="clipboard-list" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">Service Requests</span>
      </a>
      <% } %>
      <% if (role === 'buyer') { %>
      <a <%- link('demand-board', '/demand-board', 'Buyer Demand') %>>
        <span class="sidebar-link-icon"><i data-lucide="clipboard-list" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">My Demand Posts</span>
      </a>
      <% } %>
    </div>

    <div class="rail-group">
      <p class="rail-group-label" id="grp-comm">Communication</p>
      <a <%- link('messages', '/messages', 'Messages') %>>
        <span class="sidebar-link-icon"><i data-lucide="message-square" aria-hidden="true"></i></span>
                <span class="sidebar-link-text">Messages</span>
        <span class="sidebar-badge sidebar-badge-green" style="<%= unreadMsg > 0 ? '' : 'display:none;' %>"><%= unreadMsg %></span>
      </a>
      <a <%- link('notifications', '/notifications', 'Notifications') %>>
        <span class="sidebar-link-icon"><i data-lucide="bell" aria-hidden="true"></i></span>
                <span class="sidebar-link-text">Notifications</span>
        <span class="sidebar-badge sidebar-badge-red" style="<%= unreadNotif > 0 ? '' : 'display:none;' %>"><%= unreadNotif %></span>
      </a>
    </div>

    <div class="rail-group">
      <p class="rail-group-label" id="grp-account">Account & Resources</p>
      <a <%- link('profile', '/profile', 'Profile & Settings') %>>
        <span class="sidebar-link-icon"><i data-lucide="user" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">Profile & Settings</span>
      </a>
      <a <%- link('why-us', '/why-us', 'How AgriConnect works') %>>
        <span class="sidebar-link-icon"><i data-lucide="circle-help" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">How it Works</span>
      </a>
      <% if (role === 'admin') { %>
      <a <%- link('admin', '/admin', 'Admin Panel') %>>
        <span class="sidebar-link-icon"><i data-lucide="shield" aria-hidden="true"></i></span>
        <span class="sidebar-link-text">Admin Panel</span>
      </a>
      <% } %>
    </div>
  </nav>

  <!-- Footer: theme toggle + sign out + collapse -->
  <div class="sidebar-footer">
    <button type="button"
            class="sidebar-link sidebar-link--theme"
            id="railTheme" data-tooltip="Toggle Theme"
            aria-label="Toggle Theme">
      <span class="sidebar-link-icon"><i data-lucide="moon" aria-hidden="true"></i></span>
      <span class="sidebar-link-text">Theme</span>
    </button>
    <button type="button"
            class="sidebar-link sidebar-link--signout"
            id="railSignOut" data-tooltip="Sign Out"
            aria-label="Sign Out">
      <span class="sidebar-link-icon"><i data-lucide="log-out" aria-hidden="true"></i></span>
      <span class="sidebar-link-text">Sign Out</span>
    </button>

    <button type="button"
            class="sidebar-collapse-toggle"
            id="railCollapse"
            aria-label="Collapse sidebar"
            aria-controls="dashSidebar"
            aria-expanded="true">
      <span class="rail-collapse-icon rail-collapse-icon--close"><i data-lucide="panel-left-close" aria-hidden="true"></i></span>
      <span class="rail-collapse-icon rail-collapse-icon--open"><i data-lucide="panel-left-open" aria-hidden="true"></i></span>
      <span class="rail-collapse-label">Collapse</span>
    </button>
  </div>
</aside>

<!-- Behavior Script Block -->
<script>
  (function(){
    'use strict';
    var root = document.documentElement;
    var sidebar = document.getElementById('dashSidebar');
    var toggleBtn = document.getElementById('sidebarToggle');
    var overlay = document.getElementById('sidebarOverlay');
    if (!sidebar) return;

    var isCollapsed = function(){ return root.classList.contains('sidebar-collapsed'); };
    var save = function(v){ try{ localStorage.setItem('agri.sidebarCollapsed', String(v)); }catch(e){} };
    var apply = function(collapsed, skipStorage){
      if (collapsed){ root.classList.add('sidebar-collapsed'); if (toggleBtn) toggleBtn.setAttribute('aria-expanded','false'); }
      else { root.classList.remove('sidebar-collapsed'); if (toggleBtn) toggleBtn.setAttribute('aria-expanded','true'); }
      if (!skipStorage) save(collapsed);
      root.dispatchEvent(new CustomEvent('agri:sidebar:collapsed', { detail: { collapsed: collapsed } }));
    };

    var initCollapse = function(){
      var stored, collapsed;
      try{ stored = localStorage.getItem('agri.sidebarCollapsed'); }catch(e){}
      collapsed = (stored === 'true') ? true : (window.innerWidth <= 900);
      apply(collapsed, true);
    };
    initCollapse();

    /* Drawer handlers */
    var openDrawer  = function(){ sidebar.classList.add('open'); if (overlay) overlay.classList.add('open'); if (toggleBtn) toggleBtn.setAttribute('aria-expanded','true'); document.body.style.overflow='hidden'; };
    var closeDrawer = function(){ sidebar.classList.remove('open'); if (overlay) overlay.classList.remove('open'); if (toggleBtn) toggleBtn.setAttribute('aria-expanded','false'); document.body.style.overflow=''; };

    if (toggleBtn) {
      toggleBtn.addEventListener('click', function(){
        if (window.innerWidth <= 900) {
          if (sidebar.classList.contains('open')) { closeDrawer(); } else { openDrawer(); }
        } else {
          apply(!isCollapsed());
        }
      });
    }

    if (overlay) overlay.addEventListener('click', closeDrawer);

    window.addEventListener('resize', function(){
      if (window.innerWidth > 900) {
        sidebar.classList.remove('open');
        if (overlay) overlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    });

    var signOut = function(e){
      e.preventDefault();
      var btn = document.getElementById('railSignOut');
      if (btn) btn.disabled = true;
      var form = document.createElement('form');
      form.method = 'POST'; form.action = '/api/auth/logout';
      document.body.appendChild(form);
      form.submit();
    };

    var themeBtn = document.getElementById('railTheme');
    var signOutBtn = document.getElementById('railSignOut');
    var collapseBtn = document.getElementById('railCollapse');

    if (themeBtn) {
      themeBtn.setAttribute('data-theme-toggle', '');
      themeBtn.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'dark' ? 'true' : 'false');
    }
    if (signOutBtn) signOutBtn.addEventListener('click', signOut);
    if (collapseBtn) {
      collapseBtn.addEventListener('click', function () {
        apply(!isCollapsed());
      });
    }

    var renderIcons = function(){ try{ if(window.lucide){ lucide.createIcons(); } }catch(_){} };
    if (document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', renderIcons); } else { renderIcons(); }
  })();
</script>
