<%- include('partials/header') %> <%- include('partials/navbar') %>

<div class="auth-wrapper">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-head">
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-sub">Sign in to your AgriConnect KE account.</p>
      </div>

      <!-- Error / success banner -->
      <div id="auth-banner" class="auth-banner" style="display: none"></div>

      <form id="login-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="form-group">
          <label class="form-label" for="identifier">Phone Number or Email</label>
          <input
            id="identifier"
            type="text"
            class="form-input"
            placeholder="07XX XXX XXX or email"
            required
            autocomplete="username"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input
            id="password"
            type="password"
            class="form-input"
            placeholder="Your password"
            required
            autocomplete="current-password"
          />
        </div>

        <button type="submit" id="login-btn" class="btn btn-fill btn-full auth-submit-btn">Sign In</button>
      </form>

      <!-- Divider -->
      <div class="auth-divider">
        <span></span>
        <em>or</em>
        <span></span>
      </div>

      <!-- WhatsApp phone login -->
      <a href="/phone-verify?mode=login" class="btn-whatsapp-alt">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2.01C6.48 2.01 2 6.49 2 12.07c0 2.13.56 4.18 1.61 6.03l-1.03 3.87 3.94-1.07c1.67 1.01 3.66 1.53 5.67 1.53 5.56 0 10.04-4.48 10.04-10.07S17.6 2.01 12.04 2.01z"/>
        </svg>
        Sign in with WhatsApp
      </a>

      <div class="auth-footer">Don't have an account? <a href="/register">Register free →</a></div>
    </div>

    <!-- Right: Visual Fresh Produce Hero Card -->
    <div class="auth-visual" aria-hidden="true">
      <div class="auth-visual-inner">
        <img src="/images/harvest-produce.png" alt="Fresh Harvest Organic Produce" class="auth-visual-img" />
      </div>
    </div>
  </div>
</div>

<%- include('partials/chatbot') %>
<%- include('partials/scripts') %>

<script>
  document.getElementById('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('login-btn');
    const banner = document.getElementById('auth-banner');

    btn.disabled = true;
    btn.textContent = 'Signing in…';
    banner.style.display = 'none';

    const identifier = document.getElementById('identifier').value.trim();
    const password = document.getElementById('password').value;

    // Decide whether identifier is email or phone
    const isEmail = identifier.includes('@');
    const body = isEmail ? { email: identifier, password } : { phone_number: identifier, password };

    try {
      const doSubmit = async (token, isRetry) => {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': token,
          },
          body: JSON.stringify(body),
        });
        const data = await res.json();

        if (res.status === 403 && !isRetry) {
          const fresh = await (window.agriRefreshCsrfToken
            ? window.agriRefreshCsrfToken()
            : null);
          if (fresh) return doSubmit(fresh, true);
        }

        if (!res.ok) {
          banner.className = 'auth-banner error';
          banner.textContent = data.message || 'Login failed.';
          banner.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Sign In';
          return;
        }

        // Auth cookie is set httpOnly by the server — just redirect.
        window.location.href = '/dashboard';
      };

      await doSubmit(window.agriCsrfToken || '', false);
    } catch (err) {
      banner.className = 'auth-banner error';
      banner.textContent = 'Network error. Please try again.';
      banner.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Sign In';
    }
  });
</script>
