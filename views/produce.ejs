<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="dash-main">
  <%- include('partials/sidebar', { currentPage: 'produce' }) %>

  <div class="dash-content">
    <div class="dash-topbar">
      <div>
        <h1 class="dash-greeting">My Produce</h1>
        <p class="dash-sub">Manage your listings, track stock, sales, and profits.</p>
      </div>
      <div class="dash-header-actions">
        <a href="/produce/new" class="btn btn-amber"><i data-lucide="plus"></i> Add Produce</a>
      </div>
    </div>

    <div class="dash-stats">
      <div class="stat-card">
        <div class="stat-icon emerald"><i data-lucide="package"></i></div>
        <div class="stat-info">
          <div class="stat-num"><%= totals.count %></div>
          <div class="stat-label">Total Produce</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon blue"><i data-lucide="warehouse"></i></div>
        <div class="stat-info">
          <div class="stat-num"><%= Number(totals.stock).toLocaleString() %> <%= produce.length > 0 ? (produce[0].unit || 'kg') : 'kg' %></div>
          <div class="stat-label">Total Stock</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon gold"><i data-lucide="trending-up"></i></div>
        <div class="stat-info">
          <div class="stat-num"><%= Number(totals.kgSold).toLocaleString() %> <%= produce.length > 0 ? (produce[0].unit || 'kg') : 'kg' %></div>
          <div class="stat-label">Total Sales</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon purple"><i data-lucide="banknote"></i></div>
        <div class="stat-info">
          <div class="stat-num">KES <%= Number(totals.revenue).toLocaleString() %></div>
          <div class="stat-label">Total Revenue</div>
        </div>
      </div>
    </div>

    <div class="dash-section">
      <div class="dash-section-header">
        <h2 class="dash-section-title">All Produce</h2>
      </div>

      <% if (produce && produce.length > 0) { %>
      <div style="overflow-x:auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Produce</th>
              <th>Category</th>
              <th>Stock (<%= produce.length > 0 ? (produce[0].unit || 'kg') : 'kg' %>)</th>
              <th>Price (KES/<%= produce.length > 0 ? (produce[0].unit || 'kg') : 'kg' %>)</th>
              <th>Sales (<%= produce.length > 0 ? (produce[0].unit || 'kg') : 'kg' %>)</th>
              <th>Revenue (KES)</th>
              <th>Status</th>
              <th>Pending Orders</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% produce.forEach(p => { %>
            <tr>
              <td>
                <div style="display:flex; align-items:center; gap:0.75rem;">
                  <div style="width:48px; height:48px; border-radius:8px; background:var(--cream); border:1px solid var(--stone); display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;">
                    <% if (p.imageUrl) { %>
                      <img src="<%= p.imageUrl %>" alt="<%= p.name %>" style="width:100%; height:100%; object-fit:cover;">
                    <% } else { %>
                      <i data-lucide="image" style="width:20px; height:20px; color:var(--ink-soft); opacity:0.4;"></i>
                    <% } %>
                  </div>
                  <div>
                    <div style="font-weight:600; color:var(--ink);"><%= p.name %></div>
                    <div style="font-size:0.85rem; color:var(--ink-soft);"><%= p.county %></div>
                  </div>
                </div>
              </td>
              <td><%= p.category %></td>
              <td style="font-weight:600;"><%= Number(p.quantityKg).toLocaleString() %> <%= p.unit || 'kg' %></td>
              <td>KES <%= Number(p.pricePerKgKes).toLocaleString() %> / <%= p.unit || 'kg' %></td>
              <td style="font-weight:600; color:var(--emerald);"><%= Number(p.kgSold).toLocaleString() %> <%= p.unit || 'kg' %></td>
              <td style="font-weight:600; color:var(--gold);">KES <%= Number(p.revenue).toLocaleString() %></td>
              <td>
                <span style="font-size:0.85rem; padding:4px 10px; border-radius:12px; font-weight:500;
                  background:<%= p.status === 'LISTED' ? '#d1e7dd' : p.status === 'SOLD' ? '#fff3cd' : p.status === 'PENDING' ? '#e2e3e5' : '#f8d7da' %>;
                  color:<%= p.status === 'LISTED' ? '#0f5132' : p.status === 'SOLD' ? '#856404' : p.status === 'PENDING' ? '#383d41' : '#842029' %>">
                  <%= p.status %>
                </span>
              </td>
              <td>
                <% if (p.pendingOrders > 0) { %>
                  <span style="font-weight:600; color:var(--gold);"><%= p.pendingOrders %></span>
                <% } else { %>
                  <span style="color:var(--ink-soft);">0</span>
                <% } %>
              </td>
              <td>
                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                  <a href="/produce/<%= p.id %>" class="btn btn-outline" style="padding:0.35rem 0.75rem; font-size:0.85rem;">View</a>
                  <a href="/produce/<%= p.id %>/edit" class="btn btn-outline" style="padding:0.35rem 0.75rem; font-size:0.85rem;">Edit</a>
                  <button type="button" class="btn btn-amber" style="padding:0.35rem 0.75rem; font-size:0.85rem;" onclick="openRequestModal(<%= p.id %>, <%= p.quantityKg %>, '<%= p.unit || 'kg' %>', '<%= p.name %>')">Request Order</button>
                  <form action="/produce/<%= p.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-outline" style="padding:0.35rem 0.75rem; font-size:0.85rem; color:#d9534f; border-color:#d9534f;">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty-state-card" style="padding:4rem 2rem; text-align:center;">
        <i data-lucide="package-open" style="width:64px; height:64px; color:var(--ink-soft); opacity:0.5; margin-bottom:1rem;"></i>
        <h4 style="margin-bottom:0.5rem;">No produce listed yet</h4>
        <p style="color:var(--ink-soft); margin-bottom:1.5rem;">Start selling to buyers across Kenya.</p>
        <a href="/produce/new" class="btn btn-amber">Post First Listing</a>
      </div>
      <% } %>
    </div>
  </div>
</main>

<!-- Request Order Modal -->
<div id="requestOrderModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:2000; align-items:center; justify-content:center;">
  <div style="background:var(--white); border-radius:12px; padding:2rem; max-width:500px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.2);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
      <h3 style="margin:0; color:var(--emerald);">Request Order</h3>
      <button type="button" onclick="closeRequestModal()" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--ink-soft);">&times;</button>
    </div>
    <p id="requestModalProduceName" style="color:var(--ink-soft); margin-bottom:1.5rem;"></p>
    <form id="requestOrderForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="listing_id" id="requestListingId">
      <div class="form-group" style="margin-bottom:1.5rem;">
        <label for="requestBuyerId">Buyer User ID *</label>
        <input type="number" id="requestBuyerId" name="buyer_id" required placeholder="Enter buyer user ID" style="width:100%; padding:0.75rem; border:1px solid var(--stone); border-radius:8px; font-size:1rem;">
        <p style="font-size:0.85rem; color:var(--ink-soft); margin-top:0.5rem;">Enter the user ID of the buyer you want to request an order from.</p>
      </div>
      <div class="form-group" style="margin-bottom:1.5rem;">
        <label for="requestQuantity">Quantity (<span id="requestUnitLabel">kg</span>) *</label>
        <input type="number" id="requestQuantity" name="quantity_kg" required min="0.1" step="0.1" style="width:100%; padding:0.75rem; border:1px solid var(--stone); border-radius:8px; font-size:1rem;">
      </div>
      <div style="display:flex; gap:1rem; justify-content:flex-end;">
        <button type="button" onclick="closeRequestModal()" class="btn btn-outline">Cancel</button>
        <button type="submit" class="btn btn-amber">Send Request</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRequestModal(listingId, availableKg, unit, name) {
    document.getElementById('requestOrderModal').style.display = 'flex';
    document.getElementById('requestModalProduceName').textContent = 'Requesting order for: ' + name + ' (Available: ' + availableKg + ' ' + unit + ')';
    document.getElementById('requestListingId').value = listingId;
    document.getElementById('requestQuantity').max = availableKg;
    document.getElementById('requestQuantity').value = '';
    document.getElementById('requestBuyerId').value = '';
    var unitLabel = document.getElementById('requestUnitLabel');
    if (unitLabel) unitLabel.textContent = unit || 'kg';
  }

  function closeRequestModal() {
    document.getElementById('requestOrderModal').style.display = 'none';
  }

  document.getElementById('requestOrderModal').addEventListener('click', function(e) {
    if (e.target === this) closeRequestModal();
  });

  document.getElementById('requestOrderForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    try {
      const res = await fetch('/api/orders/request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          listing_id: document.getElementById('requestListingId').value,
          buyer_id: document.getElementById('requestBuyerId').value,
          quantity_kg: document.getElementById('requestQuantity').value,
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        alert(data.message || 'Failed to send order request.');
        btn.disabled = false;
        btn.textContent = originalText;
        return;
      }
      alert('Order request sent successfully!');
      closeRequestModal();
      window.location.reload();
    } catch (err) {
      alert('Network error. Please try again.');
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });

  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>

<%- include('partials/footer') %>
