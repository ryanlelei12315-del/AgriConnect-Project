<%- include('partials/header') %> 
<%- include('partials/navbar') %>
<%
  // Landing works with or without route data (404/error renders pass none).
  const lp = Array.isArray(locals.produce) ? locals.produce : [];
  const ls = Array.isArray(locals.services) ? locals.services : [];
  const mp = Array.isArray(locals.marketPrices) ? locals.marketPrices : [];
  const pc = Number.isFinite(locals.produceCount) ? locals.produceCount : 0;
  const sc = Number.isFinite(locals.serviceCount) ? locals.serviceCount : 0;
%>

<!-- ══ HERO ══ -->
<section class="hero">
  <div class="hero-left">
    <div class="hero-eyebrow">
      <div class="eyebrow-line"></div>
      <span class="eyebrow-text">Kenya's Farm-Direct Platform</span>
    </div>

    <h1 class="hero-headline">
      Grow more.<br />
      <span class="green">Earn</span> what your<br />
      harvest is <span class="mark">worth</span>.
    </h1>

    <p class="hero-desc">
      AgriConnect KE connects Kenyan farmers directly with buyers and agricultural service
      providers. Agree on prices and terms directly — no broker in the middle.
    </p>

    <div class="hero-actions">
      <a href="/marketplace" class="btn btn-amber">Browse Produce →</a>
      <a href="/services" class="btn btn-outline">Find Farm Services</a>
    </div>

    <% if (pc + sc > 0) { %>
      <div class="hero-proof">
        <div class="proof-item">
          <div class="proof-num"><%= pc %></div>
          <div class="proof-label">produce listings live now</div>
        </div>
        <div class="proof-divider"></div>
        <div class="proof-item">
          <div class="proof-num"><%= sc %></div>
          <div class="proof-label">farm services available</div>
        </div>
      </div>
    <% } else { %>
      <p class="hero-capabilities">Farm-direct trade · County search · Farm services · Market price reference</p>
    <% } %>
  </div>

  <div class="hero-right">
    <style>
      .hero-bg-carousel {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 420px;
        overflow: hidden;
        border-radius: 16px;
      }
      .hero-bg-slide {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background-size: cover;
        background-position: center;
        opacity: 0;
        transition: opacity 1s ease-in-out;
        z-index: 1;
      }
      .hero-bg-slide.active {
        opacity: 1;
      }
      .hero-bg-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.45) 0%, rgba(15, 23, 42, 0.85) 100%);
        z-index: 2;
      }
    </style>
    <div class="hero-bg-carousel" id="heroCarousel">
      <div class="hero-bg-slide active" style="background-image: url('https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=1200&q=80');"></div>
      <div class="hero-bg-slide" style="background-image: url('https://images.unsplash.com/photo-1592417817098-8f3d6ef23a28?auto=format&fit=crop&w=1200&q=80');"></div>
      <div class="hero-bg-slide" style="background-image: url('https://images.unsplash.com/photo-1586771107445-d3ca888129ff?auto=format&fit=crop&w=1200&q=80');"></div>
      <div class="hero-bg-overlay"></div>
    </div>
    <div class="hero-cards-label" style="position:relative; z-index:5;">Fresh from the marketplace</div>
    <div class="live-cards" style="position:relative; z-index:5;">
      <% if (lp.length === 0 && ls.length === 0) { %>
        <div class="lc">
          <div class="lc-icon"><i data-lucide="leaf"></i></div>
          <div class="lc-info">
            <div class="lc-name">New listings appear here</div>
            <div class="lc-sub">as farmers and providers post them</div>
          </div>
        </div>
      <% } %>
      <% lp.slice(0, 2).forEach(p => { %>
        <a class="lc" href="/produce/<%= p.id %>">
          <div class="lc-icon"><i data-lucide="<%= p.category === 'Cereals' ? 'wheat' : p.category === 'Fruits' || p.category === 'Vegetables' ? 'apple' : 'package' %>"></i></div>
          <div class="lc-info">
            <div class="lc-name"><%= p.name %></div>
            <div class="lc-sub"><%= p.county %> · <%= Number(p.quantityKg).toLocaleString() %> kg</div>
          </div>
          <div class="lc-price">KES <%= Number(p.pricePerKgKes).toLocaleString() %>/kg</div>
        </a>
      <% }) %>
      <% ls.slice(0, 2).forEach(s => { %>
        <a class="lc" href="/services/<%= s.id %>">
          <div class="lc-icon"><i data-lucide="wrench"></i></div>
          <div class="lc-info">
            <div class="lc-name"><%= s.title %></div>
            <div class="lc-sub"><%= s.county %> · <%= s.category %></div>
          </div>
          <div class="lc-price">KES <%= Number(s.priceKes).toLocaleString() %></div>
        </a>
      <% }) %>
    </div>

    <div class="hero-roles">
      <div class="role-chip" onclick="location.href = '/register'">
        <div class="ri"><i data-lucide="user"></i></div>
        <div class="rl">Farmer</div>
      </div>
      <div class="role-chip" onclick="location.href = '/register'">
        <div class="ri"><i data-lucide="shopping-cart"></i></div>
        <div class="rl">Buyer</div>
      </div>
      <div class="role-chip" onclick="location.href = '/register'">
        <div class="ri"><i data-lucide="wrench"></i></div>
        <div class="rl">Provider</div>
      </div>
    </div>
  </div>
</section>

    <!-- ══ MARQUEE ══ -->
    <div class="marquee-strip">
      <div class="marquee-track" id="marquee" aria-hidden="true">
        <span class="marquee-item"><span class="marquee-dot"></span>Uasin Gishu</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Nakuru</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Eldoret</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Meru</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kisumu</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kajiado</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Embu</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Naivasha</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kericho</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Trans Nzoia</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kakamega</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kiambu</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Uasin Gishu</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Nakuru</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Eldoret</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Meru</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kisumu</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kajiado</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Embu</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Naivasha</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kericho</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Trans Nzoia</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kakamega</span>
        <span class="marquee-item"><span class="marquee-dot"></span>Kiambu</span>
      </div>
    </div>

    <!-- ══ PRODUCE ══ -->
    <section class="section">
      <div class="row-head">
        <div>
          <div class="section-tag">
            <div class="tag-line"></div>
            <span class="tag-text">Farm Fresh</span>
          </div>
          <h2 class="section-heading">Featured Produce</h2>
          <p class="section-sub">
            Posted directly by farmers. Browse and request to buy with one click.
          </p>
        </div>
        <a href="/marketplace" class="btn btn-outline">View all listings →</a>
      </div>

            <div class="produce_section">
        <% if (lp.length > 0) { %>
          <% produce.forEach(p => { %>
            <a class="pc" href="/produce/<%= p.id %>">
              <div class="pc-img">
                <% if (p.imageUrl) { %>
                  <img src="<%= p.imageUrl %>" alt="<%= p.name %>" />
                <% } else { %>
                  <div class="pc-img-fallback" aria-hidden="true"><i data-lucide="image"></i></div>
                <% } %>
                <span class="pc-tag"><%= p.county %></span>
              </div>
              <div class="pc-body">
                <div class="pc-name"><%= p.name %></div>
                <div class="pc-farmer"><%= p.farmer ? 'Posted by ' + p.farmer.fullName : 'Posted by a farmer on AgriConnect' %></div>
                <div class="pc-bottom">
                  <span class="pc-qty"><%= Number(p.quantityKg).toLocaleString() %> kg available</span>
                  <span class="pc-price">KES <%= Number(p.pricePerKgKes).toLocaleString() %> <small>/kg</small></span>
                </div>
                <span class="pc-cta">View listing</span>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="empty-state" style="grid-column: 1 / -1;">
            <i data-lucide="package-open"></i>
            <h3>No produce listed yet</h3>
            <p style="color: var(--ink-soft);">Be the first to post your harvest — it will appear here for buyers across Kenya.</p>
            <a href="/register" class="btn btn-outline mt-2">Join as a Farmer</a>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ══ COUNTIES ══ -->
<div class="counties-section">
  <div class="counties-label">Browse by county</div>
  <div class="counties-list">
    <a href="/marketplace?county=Uasin+Gishu" class="county-pill">Uasin Gishu</a>
    <a href="/marketplace?county=Nakuru" class="county-pill">Nakuru</a>
    <a href="/marketplace?county=Eldoret" class="county-pill">Eldoret</a>
    <a href="/marketplace?county=Meru" class="county-pill">Meru</a>
    <a href="/marketplace?county=Kisumu" class="county-pill">Kisumu</a>
    <a href="/marketplace?county=Kajiado" class="county-pill">Kajiado</a>
    <a href="/marketplace?county=Embu" class="county-pill">Embu</a>
    <a href="/marketplace?county=Naivasha" class="county-pill">Naivasha</a>
    <a href="/marketplace?county=Trans+Nzoia" class="county-pill">Trans Nzoia</a>
    <a href="/marketplace?county=Kakamega" class="county-pill">Kakamega</a>
    <a href="/marketplace?county=Kericho" class="county-pill">Kericho</a>
    <a href="/marketplace?county=Kiambu" class="county-pill">Kiambu</a>
    <a href="/marketplace?county=Nairobi" class="county-pill">Nairobi</a>
    <a href="/marketplace?county=Mombasa" class="county-pill">Mombasa</a>
  </div>
 </div>
    <!-- ══ HOW IT WORKS ══ -->
    <section class="section" id="how">
      <div class="section-tag">
        <div class="tag-line"></div>
        <span class="tag-text">How it works</span>
      </div>
      <h2 class="section-heading">Three flows. One platform.</h2>
      <div class="how-grid">
        <div class="how-card">
          <div class="how-icon"><i data-lucide="shopping-basket"></i></div>
          <h3 class="how-title">Produce → marketplace → orders</h3>
          <p class="how-desc">Farmers post listings. Buyers browse the marketplace by county and crop. Orders are agreed directly between both parties — the platform never takes a middleman's cut.</p>
        </div>
        <div class="how-card">
          <div class="how-icon"><i data-lucide="wrench"></i></div>
          <h3 class="how-title">Services → requests → fulfilment</h3>
          <p class="how-desc">Providers list their services and availability. Customers send a request from the service page. The request is tracked from pending through to completion.</p>
        </div>
        <div class="how-card">
          <div class="how-icon"><i data-lucide="bar-chart-2"></i></div>
          <h3 class="how-title">Information → market data → decisions</h3>
          <p class="how-desc">Reference market prices help you set a fair price or judge an offer before you buy — with the data source always stated.</p>
        </div>
      </div>
    </section>

    <!-- ══ SERVICES ══ -->
    <section class="section svc-section">
      <div class="row-head">
        <div>
          <div class="section-tag">
            <div class="tag-line"></div>
            <span class="tag-text">Farm Services</span>
          </div>
          <h2 class="section-heading">Farm Services Near You</h2>
          <p class="section-sub">
            From tractor repair to irrigation — browse providers by county and request services directly.
          </p>
        </div>
        <a href="/services" class="btn btn-outline">All services →</a>
      </div>

      <div class="svc-grid">
        <% if (ls.length > 0) { %>
          <% ls.forEach(s => { %>
            <a class="sc" href="/services/<%= s.id %>">
              <div class="sc-icon"><i data-lucide="<%= s.category === 'Transport' ? 'truck' : s.category === 'Machinery' ? 'tractor' : s.category === 'Labour' ? 'users' : 'wrench' %>"></i></div>
              <div class="sc-cat"><%= s.category %></div>
              <div class="sc-name"><%= s.title %></div>
              <div class="sc-location"><%= s.county %><%= s.provider ? ' · ' + s.provider.fullName : '' %></div>
              <div class="sc-status"><%= s.availability === 'AVAILABLE' ? 'Available' : s.availability === 'BOOKED' ? 'Currently booked' : 'Currently unavailable' %></div>
              <div class="sc-price">KES <%= Number(s.priceKes).toLocaleString() %></div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="empty-state" style="grid-column: 1 / -1;">
            <i data-lucide="wrench"></i>
            <h3>No services listed yet</h3>
            <p style="color: var(--ink-soft);">Service providers can list their offerings — the first listings will appear here.</p>
            <a href="/register" class="btn btn-outline mt-2">Join as a Provider</a>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ══ MARKET PRICES ══ -->
    <section class="ticker-section" id="prices">
      <div class="section-tag" style="margin-bottom: 1rem">
        <div class="tag-line"></div>
        <span class="tag-text" style="color: var(--amber-glow)">Market Intelligence</span>
      </div>
      <h2 class="section-heading" style="color: var(--white)">Market Prices</h2>
      <p class="section-sub" style="color: rgba(255, 255, 255, 0.5)">
        Reference prices recorded in the AgriConnect database — useful for orientation, not a live feed.
      </p>

      <% if (mp.length > 0) { %>
        <div class="ticker-grid">
          <% mp.forEach(m => { %>
            <div class="ticker-card">
              <div class="tc-crop"><%= m.category %></div>
              <div class="tc-name"><%= m.produceName %></div>
              <div class="tc-price">KES <%= Number(m.price).toLocaleString() %></div>
              <div class="tc-unit">per <%= m.unit || 'unit' %> · <%= m.marketName %></div>
              <% if (Number(m.priceChange) !== 0) { %>
                <div class="tc-trend <%= Number(m.priceChange) > 0 ? 'up' : 'down' %>">
                  <%= Number(m.priceChange) > 0 ? '↑' : '↓' %> <%= Math.abs(Number(m.priceChange)) %>% recorded change
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
        <p class="ticker-note">
          Stored reference prices — verify before making trading decisions.
          <a href="/market-prices">See live feed status →</a>
        </p>
      <% } else { %>
        <div class="ticker-empty">
          <p>No price data available right now.</p>
          <a href="/market-prices">Check market prices →</a>
        </div>
      <% } %>
    </section>

    <!-- ══ WHY ══ -->
    <section class="section" id="why">
      <div class="section-tag">
        <div class="tag-line"></div>
        <span class="tag-text">Why AgriConnect</span>
      </div>
      <h2 class="section-heading">Built for Kenya's farmers.<br />Not for brokers.</h2>

      <div class="why-grid">
        <div class="wc">
          <div class="wc-num">01</div>
          <div class="wc-icon"><i data-lucide="ban"></i></div>
          <div class="wc-title">Zero brokers</div>
          <div class="wc-desc">
            Sell your produce directly to verified buyers and keep every shilling you earn.
          </div>
        </div>
        <div class="wc">
          <div class="wc-num">02</div>
          <div class="wc-icon"><i data-lucide="map-pin"></i></div>
          <div class="wc-title">County-first search</div>
          <div class="wc-desc">
            Find buyers and service providers in your exact county — no wasted trips.
          </div>
        </div>
        <div class="wc">
          <div class="wc-num">03</div>
          <div class="wc-icon"><i data-lucide="clipboard-list"></i></div>
          <div class="wc-title">Direct service requests</div>
          <div class="wc-desc">
            Browse provider profiles, availability and pricing — then request the service you need directly.
          </div>
        </div>
        <div class="wc">
          <div class="wc-num">04</div>
          <div class="wc-icon"><i data-lucide="smartphone"></i></div>
          <div class="wc-title">Phone-first</div>
          <div class="wc-desc">
            Designed for the phone in your pocket. Works on 3G. Built for rural Kenya.
          </div>
        </div>
      </div>
    </section>

    <!-- ══ CTA ══ -->
    <section class="cta-section">
      <div class="cta-left">
        <div class="section-tag" style="margin-bottom: 1rem">
          <div class="tag-line"></div>
          <span class="tag-text" style="color: var(--amber-glow)">Get Started</span>
        </div>
        <h2 class="section-heading" style="color: var(--white); margin-bottom: 1rem">
          Join Kenya's farm-direct community.
        </h2>
        <p class="section-sub" style="color: rgba(255, 255, 255, 0.6); margin-bottom: 2rem">
          Free to join. Set your own prices and connect directly — register today.
        </p>
        <a href="/register" class="btn btn-amber">Create Free Account →</a>
      </div>

      <div class="cta-role-cards">
        <a href="/register" class="role-card">
          <div class="role-card-icon"><i data-lucide="user"></i></div>
          <div class="role-card-info">
            <div class="role-card-name">I'm a Farmer</div>
            <div class="role-card-desc">Post produce and request farm services</div>
          </div>
          <div class="role-card-arrow">→</div>
        </a>
        <a href="/register" class="role-card">
          <div class="role-card-icon"><i data-lucide="shopping-cart"></i></div>
          <div class="role-card-info">
            <div class="role-card-name">I'm a Buyer</div>
            <div class="role-card-desc">Browse fresh produce from nearby farms</div>
          </div>
          <div class="role-card-arrow">→</div>
        </a>
        <a href="/register" class="role-card">
          <div class="role-card-icon"><i data-lucide="wrench"></i></div>
          <div class="role-card-info">
            <div class="role-card-name">I'm a Service Provider</div>
            <div class="role-card-desc">List your agricultural services for hire</div>
          </div>
          <div class="role-card-arrow">→</div>
        </a>
      </div>
    </section>

    <script>
      (function() {
        const slides = document.querySelectorAll('#heroCarousel .hero-bg-slide');
        if (slides.length > 1) {
          let current = 0;
          setInterval(function() {
            slides[current].classList.remove('active');
            current = (current + 1) % slides.length;
            slides[current].classList.add('active');
          }, 5000);
        }
      })();
    </script>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </div>
</body>
</html>
