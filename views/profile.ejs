<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="dash-main">
  <%- include('partials/sidebar', { currentPage: 'profile' }) %>

  <div class="dash-content">
    <div class="dash-topbar">
      <div>
        <h1 class="dash-greeting">My Profile</h1>
        <p class="dash-sub">Manage your personal information and account settings.</p>
      </div>
    </div>

    <% if (typeof image !== 'undefined' && image) { %>
      <div class="alert alert-success">Profile photo updated successfully.</div>
    <% } %>
    <% if (typeof updated !== 'undefined' && updated) { %>
      <div class="alert alert-success">Profile updated successfully.</div>
    <% } %>
    <% if (typeof password !== 'undefined' && password) { %>
      <div class="alert alert-success">Password updated successfully.</div>
    <% } %>

    <div class="profile-section">
      <h2 class="profile-section-title">Personal Information</h2>
      <form action="/profile/update" method="POST" class="settings-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
          <div class="form-group">
            <label for="fullName" class="form-label">Full Name</label>
            <input type="text" id="fullName" name="fullName" class="form-input" value="<%= user.fullName %>" required>
          </div>
          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" class="form-input" value="<%= user.email %>" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="phoneNumber" class="form-label">Phone Number</label>
            <input type="text" id="phoneNumber" name="phoneNumber" class="form-input" value="<%= user.phoneNumber %>" required>
          </div>
          <div class="form-group">
            <label for="county" class="form-label">County</label>
            <select id="county" name="county" class="form-input" required>
              <% const counties = ['Uasin Gishu','Nakuru','Trans Nzoia','Meru','Kiambu','Kajiado','Nairobi','Mombasa','Kisumu','Eldoret','Embu','Naivasha','Kakamega','Kericho',"Murang'a",'Other']; %>
              <% counties.forEach(function(c) { %>
                <option value="<%= c %>" <%= user.county === c ? 'selected' : '' %>><%= c %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="bio" class="form-label">Bio / About You</label>
          <textarea id="bio" name="bio" class="form-input" rows="3" maxlength="500" placeholder="e.g. Maize and avocado farmer in Uasin Gishu — 120 acres, selling to local buyers…"><%= user.bio || '' %></textarea>
        </div>

        <div class="form-actions">
          <a href="/dashboard" class="btn btn-outline">Cancel</a>
          <button type="submit" class="btn btn-amber">Save Changes</button>
        </div>
      </form>
    </div>

    <div class="profile-section">
      <h2 class="profile-section-title">Change Password</h2>
      <form action="/profile/password" method="POST" class="settings-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="currentPassword" class="form-label">Current Password</label>
          <input type="password" id="currentPassword" name="currentPassword" class="form-input" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="newPassword" class="form-label">New Password</label>
            <input type="password" id="newPassword" name="newPassword" class="form-input" required>
          </div>
          <div class="form-group">
            <label for="confirmPassword" class="form-label">Confirm Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" required>
          </div>
        </div>
        <div class="form-actions">
          <a href="/dashboard" class="btn btn-outline">Cancel</a>
          <button type="submit" class="btn btn-outline">Update Password</button>
        </div>
      </form>
    </div>

    <div class="profile-section">
      <h2 class="profile-section-title">Profile Photo</h2>
      <div style="display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap;">
        <div class="profile-avatar" style="width:80px; height:80px; font-size:1.75rem; margin:0;">
          <% if (user.profileImage) { %>
            <img src="<%= user.profileImage %>" alt="Profile">
          <% } else { %>
            <%= user.fullName ? user.fullName.charAt(0).toUpperCase() : '?' %>
          <% } %>
        </div>
        <div style="flex:1; min-width:200px;">
          <p style="margin:0 0 0.5rem; color:var(--ink-soft); font-size:0.9rem;">Upload a new photo to update your profile picture across the platform.</p>
          <form action="/profile/image" method="POST" enctype="multipart/form-data" class="profile-upload-form" style="margin-top:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="btn btn-outline" style="cursor:pointer; display:inline-flex; align-items:center; gap:6px;">
              <i data-lucide="camera"></i> Upload Photo
              <input type="file" name="image" accept="image/*" style="display:none;" onchange="this.form.submit()">
            </label>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  lucide.createIcons();
  document.querySelector('form[action="/profile/password"]').addEventListener('submit', function(e) {
    const p1 = document.getElementById('newPassword').value;
    const p2 = document.getElementById('confirmPassword').value;
    if (p1 !== p2) {
      e.preventDefault();
      alert('New passwords do not match.');
    }
  });
</script>

<%- include('partials/footer') %>
