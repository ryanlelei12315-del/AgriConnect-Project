<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="auth-wrapper" style="background: var(--cream);">
  <div class="auth-card" style="max-width: 550px;">
    <div class="auth-head" style="text-align: center; margin-bottom: 2rem;">
      <div class="nav-user-avatar" id="profile-avatar" style="width: 72px; height: 72px; font-size: 2rem; margin: 0 auto 1rem; border-radius: 50%; background: var(--emerald); color: var(--white); display: grid; place-items: center; font-weight: 700;">?</div>
      <h1 class="auth-title">My Profile</h1>
      <p class="auth-sub" id="profile-role-badge" style="display: inline-block; background: rgba(27, 74, 46, 0.08); color: var(--emerald); padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; margin-top: 4px;">Loading Role...</p>
    </div>

    <!-- Banner -->
    <div id="profile-banner" class="auth-banner" style="display:none;"></div>

    <form id="profile-form">
      <div class="form-group">
        <label class="form-label">Email Address <span style="opacity: .5;">(Cannot be changed)</span></label>
        <input id="profile-email" type="email" class="form-input" disabled style="background: var(--linen); opacity: 0.7; cursor: not-allowed;">
      </div>

      <div class="form-group">
        <label class="form-label">Full Name</label>
        <input id="profile-name" type="text" class="form-input" placeholder="Your full name" required style="background: var(--linen);">
      </div>

      <div class="form-group">
        <label class="form-label">Phone Number</label>
        <input id="profile-phone" type="tel" class="form-input" placeholder="07XX XXX XXX" required style="background: var(--linen);">
      </div>

      <div class="form-group">
        <label class="form-label">County Location</label>
        <select id="profile-county" class="form-input" required style="background: var(--linen); cursor: pointer;">
          <option value="" disabled>Select your county</option>
          <option value="Uasin Gishu">Uasin Gishu</option>
          <option value="Nakuru">Nakuru</option>
          <option value="Meru">Meru</option>
          <option value="Kajiado">Kajiado</option>
          <option value="Trans Nzoia">Trans Nzoia</option>
          <option value="Nairobi">Nairobi</option>
          <option value="Kisumu">Kisumu</option>
          <option value="Kiambu">Kiambu</option>
        </select>
      </div>

      <button type="submit" id="save-btn" class="btn btn-fill btn-full" style="margin-top: 1rem;">Save Profile Changes</button>
    </form>
  </div>
</div>

<%- include('partials/scripts') %>

<script>
  // Load and check auth
  (function() {
    const token = localStorage.getItem('agri_token');
    const user = JSON.parse(localStorage.getItem('agri_user') || 'null');

    if (!token || !user) {
      window.location.href = '/login';
      return;
    }

    // Populate fields
    document.getElementById('profile-avatar').textContent = user.full_name.charAt(0).toUpperCase();
    document.getElementById('profile-email').value = user.email || 'No email registered';
    document.getElementById('profile-name').value = user.full_name;
    document.getElementById('profile-phone').value = user.phone_number || '';

    const roleLabel = {
      farmer: '🌾 Registered Farmer',
      buyer: '🛒 Fresh Produce Buyer',
      provider: '🔧 Farm Service Provider',
      admin: '👑 AgriConnect Administrator'
    }[user.role] || user.role;

    document.getElementById('profile-role-badge').textContent = roleLabel;

    if (user.county) {
      document.getElementById('profile-county').value = user.county;
    }
  })();

  // Handle submit form
  document.getElementById('profile-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = localStorage.getItem('agri_token');
    const btn = document.getElementById('save-btn');
    const banner = document.getElementById('profile-banner');

    btn.disabled = true;
    btn.textContent = 'Saving changes...';
    banner.style.display = 'none';

    const body = {
      full_name: document.getElementById('profile-name').value.trim(),
      phone_number: document.getElementById('profile-phone').value.trim(),
      county: document.getElementById('profile-county').value
    };

    try {
      const res = await fetch('/api/auth/profile', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },
        body: JSON.stringify(body)
      });
      const data = await res.json();

      if (!res.ok) {
        banner.className = 'auth-banner error';
        banner.textContent = data.message || 'Failed to update profile.';
        banner.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Save Profile Changes';
        return;
      }

      // Sync local storage user
      localStorage.setItem('agri_user', JSON.stringify(data.user));

      // Update avatar letter
      document.getElementById('profile-avatar').textContent = data.user.full_name.charAt(0).toUpperCase();

      banner.className = 'auth-banner success';
      banner.textContent = '🎉 Profile updated successfully!';
      banner.style.display = 'block';

      // Refresh navbar details if needed
      setTimeout(() => {
        banner.style.display = 'none';
        window.location.reload();
      }, 1200);

    } catch (err) {
      banner.className = 'auth-banner error';
      banner.textContent = 'Network error. Please try again.';
      banner.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Save Profile Changes';
    } finally {
      btn.disabled = false;
    }
  });
</script>
