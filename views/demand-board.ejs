<%- include('partials/header') %>
<%- include('partials/navbar') %>
<main class="page-container demand-board-page">
  <div class="page-header">
    <div class="page-header-text">
      <span class="page-eyebrow">Direct Matching</span>
      <h1 class="page-title">Buyer Demand Board</h1>
      <p class="page-subtitle">See what buyers need across Kenya, where they need it, and required quantities. Match supply directly with demand.</p>
    </div>
  </div>

  <% if (user.role === 'buyer') { %>
    <section class="demand-composer">
      <h2>Post a crop requirement</h2>
      <p>Publish what you need so farmers can contact you. A maximum price is optional; all prices remain subject to agreement.</p>
      <form action="/demand-board" method="POST" class="demand-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label">Crop / Produce Name</label>
          <input name="crop_name" class="form-input" maxlength="100" required placeholder="e.g. Dry White Maize">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label">Category</label>
          <select name="category" class="form-input" required>
            <% ['Cereals','Vegetables','Fruits','Root Crops','Legumes','Dairy','Poultry','Other'].forEach(c => { %>
              <option value="<%= c %>"><%= c %></option>
            <% }) %>
          </select>
        </label>
        <label>Quantity needed (kg)
          <input name="quantity_kg" type="number" min="0.01" max="100000000" step="0.01" required placeholder="e.g. 500" style="display:block;width:100%;margin-top:6px;">
        </label>
        <label>Maximum price (KES/kg, optional)
          <input name="max_price_per_kg_kes" type="number" min="0.01" max="100000000" step="0.01" placeholder="Leave blank if flexible" style="display:block;width:100%;margin-top:6px;">
        </label>
        <label>Delivery county
          <select name="county" required style="display:block;width:100%;margin-top:6px;"><option value="">Choose county</option><% counties.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select>
        </label>
        <label>Needed by (optional)
          <input name="required_by" type="date" style="display:block;width:100%;margin-top:6px;">
        </label>
        <label class="demand-form__wide">Quality, variety or delivery notes
          <textarea name="quality_notes" maxlength="1000" rows="3" placeholder="e.g. dry, sorted, suitable for milling" style="display:block;width:100%;margin-top:6px;"></textarea>
        </label>
        <div class="demand-form__wide"><button type="submit" class="btn btn-emerald">Publish requirement</button></div>
      </form>
    </section>
  <% } else { %>
    <div class="demand-board-note">
      <strong>Have produce to sell?</strong> Browse buyer requirements below, then <a href="/messages">message the buyer</a> to discuss quality, price, and delivery.
    </div>
  <% } %>

  <form method="GET" action="/demand-board" class="filter-bar">
    <div style="flex:1; min-width:200px;">
      <input type="search" name="search" class="form-input" placeholder="Search crop requirements..." value="<%= search %>" aria-label="Search crop requirements">
    </div>
    <div style="min-width:160px;">
      <select name="county" class="form-input" aria-label="Filter by county">
        <option value="All">All Counties</option>
        <% counties.forEach(c => { %>
          <option value="<%= c %>" <%= selectedCounty === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <button class="btn btn-emerald" type="submit">Filter Demand</button>
  </form>

  <% if (demands.length) { %>
    <div class="demand-grid">
      <% demands.forEach(d => { %>
        <article class="demand-card">
          <div style="display:flex;justify-content:space-between;gap:12px;align-items:start;">
            <span class="page-eyebrow"><%= d.category %></span>
            <span style="font-size:.78rem;padding:5px 9px;border-radius:999px;background:<%= d.status === 'OPEN' ? 'var(--color-success-bg)' : 'var(--color-neutral-bg)' %>;"><%= d.status %></span>
          </div>

          <div style="margin-top:auto; padding-top:1rem; border-top:1px solid var(--stone); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
            <span style="font-size:0.75rem; color:var(--ink-soft);">Posted <%= new Date(d.createdAt).toLocaleDateString('en-KE', { month: 'short', day: 'numeric' }) %></span>
            <% if (isBuyer && Number(d.buyerId) === Number(user.id)) { %>
              <form action="/demand-board/<%= d.id %>/status" method="POST" style="display:flex; gap:6px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (d.status === 'CLOSED') { %>
                  <button class="btn btn-outline btn-sm" name="status" value="OPEN">Reopen</button>
                <% } %>
                <% if (d.status === 'OPEN') { %>
                  <button class="btn btn-outline btn-sm" name="status" value="CLOSED">Close</button>
                  <button class="btn btn-emerald btn-sm" name="status" value="FULFILLED">Fulfilled</button>
                <% } %>
              </form>
            <% } else if (!isBuyer && d.status === 'OPEN') { %>
              <a href="/messages/<%= d.buyerId %>" class="btn btn-emerald btn-sm"><i data-lucide="message-square"></i> Contact Buyer</a>
            <% } %>
          </div>
          <% if (d.requiredBy) { %><p><small style="color:var(--color-text-muted);">Needed by</small> <strong><%= d.requiredBy %></strong></p><% } %>
          <% if (d.qualityNotes) { %><p style="margin-top:12px;overflow-wrap:anywhere;"><%= d.qualityNotes %></p><% } %>
          <p style="font-size:.8rem;color:var(--color-text-muted);margin-top:14px;">Posted <%= new Date(d.createdAt).toLocaleDateString() %></p>
          <% if (isBuyer && Number(d.buyerId) === Number(user.id)) { %>
            <form action="/demand-board/<%= d.id %>/status" method="POST" class="demand-card__actions">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (d.status === 'CLOSED') { %><button class="btn btn-outline" name="status" value="OPEN">Reopen</button><% } %>
              <% if (d.status === 'OPEN') { %><button class="btn btn-outline" name="status" value="CLOSED">Close requirement</button><button class="btn btn-emerald" name="status" value="FULFILLED">Mark fulfilled</button><% } %>
            </form>
          <% } else if (!isBuyer && d.status === 'OPEN') { %>
            <a href="/messages/<%= d.buyerId %>" class="btn btn-emerald demand-card__contact">Contact buyer</a>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i data-lucide="search-x"></i>
      <h3>No crop requirements found</h3>
      <p><%= isBuyer ? 'Publish a requirement above to let farmers know what you need.' : 'Try a different county or crop search. New buyer requirements will appear here.' %></p>
    </div>
  <% } %>
</main>

<script>
  if (window.lucide) lucide.createIcons();
</script>

<%- include('partials/footer') %>
