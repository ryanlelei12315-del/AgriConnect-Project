<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="page-container" style="max-width:800px;">
  <div style="margin-bottom:2rem;">
    <a href="/services" style="color:var(--emerald); text-decoration:none;">← Back to Services</a>
  </div>

  <div class="card" style="padding:2rem;">
    <h1 style="color:var(--emerald); font-size:1.75rem; margin-bottom:0.5rem;">List a New Service</h1>
    <p style="color:var(--ink-soft); margin-bottom:2rem;">Create a service listing so buyers can find and request your services.</p>

    <% if (error) { %>
      <div style="background:#fef2f2; color:#991b1b; padding:1rem; border-radius:8px; margin-bottom:1.5rem; border:1px solid #fecaca;">
        <%= error %>
      </div>
    <% } %>

    <form action="/services" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="form-group" style="margin-bottom:1.5rem;">
        <label for="title" style="display:block; font-weight:600; margin-bottom:0.5rem; color:var(--ink);">Service Title *</label>
        <input
          type="text"
          id="title"
          name="title"
          required
          maxlength="100"
          placeholder="e.g. Tractor Repair, Farm Transport, Irrigation Setup"
          style="width:100%; padding:0.75rem; border:1px solid var(--stone); border-radius:8px; font-size:1rem;"
        />
      </div>

      <div class="form-group" style="margin-bottom:1.5rem;">
        <label for="category" style="display:block; font-weight:600; margin-bottom:0.5rem; color:var(--ink);">Category *</label>
        <select id="category" name="category" required style="width:100%; padding:0.75rem; border:1px solid var(--stone); border-radius:8px; font-size:1rem; background:white;">
          <option value="">Select a category…</option>
          <option value="Machinery">Machinery</option>
          <option value="Transport">Transport</option>
          <option value="Infrastructure">Infrastructure</option>
          <option value="Labour">Labour</option>
          <option value="Agronomy">Agronomy</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:1.5rem;">
        <div class="form-group">
          <label for="price_kes" style="display:block; font-weight:600; margin-bottom:0.5rem; color:var(--ink);">Price (KES) *</label>
          <input
            type="number"
            id="price_kes"
            name="price_kes"
            required
            min="0"
            step="0.01"
            placeholder="0.00"
            style="width:100%; padding:0.75rem; border:1px solid var(--stone); border-radius:8px; font-size:1rem;"
          />
        </div>
        <div class="form-group">
          <label for="county" style="display:block; font-weight:600; margin-bottom:0.5rem; color:var(--ink);">County *</label>
          <input
            type="text"
            id="county"
            name="county"
            required
            maxlength="50"
            placeholder="e.g. Uasin Gishu"
            style="width:100%; padding:0.75rem; border:1px solid var(--stone); border-radius:8px; font-size:1rem;"
          />
        </div>
      </div>

      <div class="form-group" style="margin-bottom:1.5rem;">
        <label for="availability" style="display:block; font-weight:600; margin-bottom:0.5rem; color:var(--ink);">Availability *</label>
        <select id="availability" name="availability" required style="width:100%; padding:0.75rem; border:1px solid var(--stone); border-radius:8px; font-size:1rem; background:white;">
          <option value="AVAILABLE">Available</option>
          <option value="BOOKED">Booked</option>
          <option value="UNAVAILABLE">Unavailable</option>
        </select>
      </div>

      <div class="form-group" style="margin-bottom:2rem;">
        <label for="description" style="display:block; font-weight:600; margin-bottom:0.5rem; color:var(--ink);">Description <span style="font-weight:400; color:var(--ink-soft);">(optional)</span></label>
        <textarea
          id="description"
          name="description"
          rows="4"
          maxlength="2000"
          placeholder="Describe your service, experience, and what buyers can expect…"
          style="width:100%; padding:0.75rem; border:1px solid var(--stone); border-radius:8px; font-size:1rem; resize:vertical;"
        ></textarea>
      </div>

      <div style="display:flex; gap:1rem;">
        <button type="submit" class="btn btn-amber" style="flex:1; padding:1rem; font-size:1rem;">Create Service Listing</button>
        <a href="/services" class="btn btn-outline" style="padding:1rem; font-size:1rem;">Cancel</a>
      </div>
    </form>
  </div>
</main>

<script>
  lucide.createIcons();
</script>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>