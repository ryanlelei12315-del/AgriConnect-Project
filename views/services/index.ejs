<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="page-container">
  <div class="page-header">
    <div class="page-header-text">
      <span class="page-eyebrow">Trade & Labor</span>
      <h1 class="page-title">Agricultural Services</h1>
      <p class="page-subtitle">Find reliable tractors, transport, labor, and agronomy services for your farm across Kenya.</p>
    </div>
    <% if (typeof user !== 'undefined' && user && user.role === 'provider') { %>
      <div class="page-header-actions">
        <a href="/services/new" class="btn btn-amber"><i data-lucide="plus"></i> List a Service</a>
      </div>
    <% } %>
  </div>

  <form action="/services" method="GET" class="filter-bar">
    <div style="flex:1; min-width:200px;">
      <input type="text" name="search" placeholder="Search services..." value="<%= search %>" class="form-input">
    </div>
    <div style="min-width:160px;">
      <select name="category" class="form-input">
        <option value="All" <%= category === 'All' ? 'selected' : '' %>>All Categories</option>
        <option value="Machinery" <%= category === 'Machinery' ? 'selected' : '' %>>Machinery</option>
        <option value="Transport" <%= category === 'Transport' ? 'selected' : '' %>>Transport</option>
        <option value="Infrastructure" <%= category === 'Infrastructure' ? 'selected' : '' %>>Infrastructure</option>
        <option value="Labour" <%= category === 'Labour' ? 'selected' : '' %>>Labour</option>
        <option value="Agronomy" <%= category === 'Agronomy' ? 'selected' : '' %>>Agronomy</option>
        <option value="Other" <%= category === 'Other' ? 'selected' : '' %>>Other</option>
      </select>
    </div>
    <button type="submit" class="btn btn-emerald">Search</button>
  </form>

  <% if (error) { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>

  <% if (services && services.length > 0) { %>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:1.25rem;">
      <% services.forEach(service => { %>
        <div class="service-card">
          <div class="service-card-icon" aria-hidden="true">
            <i data-lucide="<%= service.category === 'Transport' ? 'truck' : service.category === 'Machinery' ? 'tractor' : service.category === 'Labour' ? 'users' : 'wrench' %>"></i>
          </div>
          <div class="service-card-body">
            <div class="service-card-top">
              <span class="service-card-category"><%= service.category %></span>
              <% if (service.availability === 'AVAILABLE') { %>
                <span class="svc-avail svc-avail--available">Available</span>
              <% } else if (service.availability === 'BOOKED') { %>
                <span class="svc-avail svc-avail--booked">Booked</span>
              <% } else { %>
                <span class="svc-avail svc-avail--unavailable">Unavailable</span>
              <% } %>
            </div>
            <h3 class="service-card-title"><%= service.title %></h3>
            <p class="service-card-meta">
              <i data-lucide="map-pin" aria-hidden="true"></i>
              <%= service.county %><%= service.provider ? ' · ' + service.provider.fullName : '' %>
            </p>
            <div class="service-card-foot">
              <span class="service-card-price">KES <%= Number(service.priceKes).toLocaleString() %> <span class="service-card-price-note">/ service</span></span>
              <a href="/services/<%= service.id %>" class="btn btn-outline">View details</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i data-lucide="wrench"></i>
      <h3>No services found</h3>
      <p>We couldn't find any services matching your search criteria.</p>
      <a href="/services" class="btn btn-outline mt-2">Clear Filters</a>
    </div>
  <% } %>
</main>

<script>
  if (window.lucide) lucide.createIcons();
</script>

<%- include('../partials/footer') %>
