<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="page-container" style="padding-top:100px; padding-bottom:4rem; max-width:1000px; margin:0 auto; padding-left:2rem; padding-right:2rem;">
  <div style="margin-bottom:1.5rem;">
    <a href="/services" style="color:var(--emerald); text-decoration:none;">← Back to Services</a>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:3rem; background:var(--white); padding:2rem; border-radius:var(--radius); box-shadow:var(--shadow-sm); border:1px solid var(--stone);">
    <!-- Details Section -->
    <div style="display:flex; flex-direction:column;">
      <span style="font-size:0.9rem; font-weight:600; color:var(--emerald); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:0.5rem;"><%= service.category %></span>
      <h1 style="color:var(--emerald); font-size:2.5rem; margin:0 0 1rem 0;"><%= service.title %></h1>
      
      <p style="font-size:1.5rem; font-weight:600; color:var(--gold); margin-bottom:1.5rem;">KES <%= Number(service.priceKes).toLocaleString() %></p>
      
      <div style="background:var(--cream); padding:1.5rem; border-radius:8px; border:1px solid var(--stone); margin-bottom:2rem;">
        <h3 style="margin-bottom:0.5rem; font-size:1.1rem;">Description</h3>
        <p style="color:var(--ink-mid); line-height:1.6; margin:0;"><%= service.description || 'No description provided.' %></p>
      </div>
      
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:2rem;">
        <div style="background:var(--cream); padding:1rem; border-radius:8px; border:1px solid var(--stone);">
          <div style="font-size:0.85rem; color:var(--ink-soft); margin-bottom:4px;">Location</div>
          <div style="font-weight:500;">📍 <%= service.county %></div>
        </div>
        <div style="background:var(--cream); padding:1rem; border-radius:8px; border:1px solid var(--stone);">
          <div style="font-size:0.85rem; color:var(--ink-soft); margin-bottom:4px;">Availability</div>
          <div style="font-weight:500;"><%= service.availability %></div>
        </div>
      </div>
    </div>

    <!-- Provider & Actions Section -->
    <div>
      <div style="border:1px solid var(--stone); border-radius:12px; padding:2rem; background:var(--cream);">
        <h3 style="margin-bottom:1rem; font-size:1.2rem; color:var(--emerald);">Provider Information</h3>
        <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem;">
          <div style="width:60px; height:60px; background:var(--emerald); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.5rem; font-weight:700;">
            <%= service.provider ? service.provider.fullName.charAt(0).toUpperCase() : '?' %>
          </div>
          <div>
            <h4 style="margin:0; font-size:1.1rem;"><%= service.provider ? service.provider.fullName : 'Unknown Provider' %></h4>
            <p style="margin:0; color:var(--ink-soft);"><%= service.provider ? service.provider.county : 'Unknown' %></p>
          </div>
        </div>

        <% if (user && user.id === service.providerId) { %>
          <div style="text-align:center;">
            <p style="color:var(--ink-soft); margin-bottom:1rem;">This is your service listing.</p>
            <a href="#" class="btn btn-outline" style="width:100%;">Edit Service</a>
          </div>
        <% } else { %>
          <div style="display:flex; flex-direction:column; gap:1rem;">
            <a href="<%= user ? '/services/' + service.id + '/request' : '/login' %>" class="btn btn-amber" style="text-align:center; padding:1rem; font-size:1.1rem;" <%= service.availability !== 'AVAILABLE' ? 'disabled style="pointer-events:none; opacity:0.6;"' : '' %>>
              <%= service.availability === 'AVAILABLE' ? 'Request Service' : 'Currently Unavailable' %>
            </a>
            <a href="<%= user ? '/messages/new?to=' + service.providerId : '/login' %>" class="btn btn-outline" style="text-align:center; padding:1rem; font-size:1.1rem;">Contact Provider</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<script>
  lucide.createIcons();
</script>

<%- include('../partials/footer') %>
