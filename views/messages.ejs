<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="dash-main">
  <%- include('partials/sidebar', { currentPage: 'messages' }) %>

  <div class="dash-content" style="padding-top:2.5rem;">
    <div class="dash-header">
      <div>
        <h1 class="dash-greeting">Messages</h1>
        <p class="dash-sub">Chat directly with buyers, farmers and service providers by name or phone number.</p>
      </div>
    </div>

    <div class="chat-layout">
      <!-- ── Conversation List ─────────────────────────────────── -->
      <div class="chat-threads" id="conversationList">
        <div class="chat-list-header">
          <span class="chat-list-title">Chats</span>
          <button class="chat-list-icon" id="newChatBtn" title="New chat by phone number"><i data-lucide="square-pen"></i></button>
        </div>
        <div class="chat-search">
          <i data-lucide="search" class="chat-search-icon"></i>
          <input type="text" class="chat-search-input" id="chatSearch" placeholder="Search or start a new chat" />
        </div>

        <% if (conversations && conversations.length > 0) { %>
          <% conversations.forEach(c => { %>
            <a href="/messages/<%= c.user.id %>" class="chat-thread-item <%= (activeUserId && Number(activeUserId) === Number(c.user.id)) ? 'active' : '' %>">
              <div class="chat-thread-avatar"><%= (c.user.fullName || '?').charAt(0).toUpperCase() %></div>
              <div class="chat-thread-details">
                <div class="chat-thread-name">
                  <span><%= c.user.fullName %></span>
                  <span class="chat-thread-time"><%= new Date(c.lastAt).toLocaleDateString('en-KE', { month: 'short', day: 'numeric' }) %></span>
                </div>
                <% if (c.user.phoneNumber) { %>
                  <div class="chat-thread-phone"><i data-lucide="phone" style="width:11px;height:11px;"></i> <%= c.user.phoneNumber %></div>
                <% } %>
                <div class="chat-thread-preview-row">
                  <span class="chat-thread-preview"><%= c.lastMessage %></span>
                  <% if (Number(c.unread) > 0) { %>
                    <span class="chat-unread-badge"><%= c.unread %></span>
                  <% } %>
                </div>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="chat-empty-msg" style="padding:2rem;text-align:center;color:var(--ink-soft);">
            <i data-lucide="message-square" style="width:36px;height:36px;opacity:0.4;margin-bottom:0.75rem;"></i>
            <p>No conversations yet.</p>
            <p style="font-size:0.82rem;margin-top:0.25rem;">Tap the pencil to search a buyer by phone number.</p>
          </div>
        <% } %>
      </div>

      <!-- ── Active Thread ─────────────────────────────────────── -->
      <div class="chat-box">
        <% if (activeUser && activeThread) { %>
          <%
            let activeWa = '';
            if (activeUser.phoneNumber) {
              let p = String(activeUser.phoneNumber).replace(/[^\d]/g, '');
              if (p.startsWith('0')) p = '254' + p.slice(1);
              else if (p.length === 9) p = '254' + p;
              activeWa = p;
            }
          %>
          <div class="chat-header">
            <div class="chat-thread-avatar"><%= (activeUser.fullName || '?').charAt(0).toUpperCase() %></div>
            <div class="chat-header-info">
              <div class="chat-header-name"><%= activeUser.fullName %></div>
              <div class="chat-header-status"><% if (activeUser.phoneNumber) { %><%= activeUser.phoneNumber %><% } else { %>online<% } %></div>
            </div>
            <div class="chat-header-actions">
              <button class="chat-header-icon" title="Search"><i data-lucide="search"></i></button>
              <% if (activeWa) { %>
                <a class="chat-header-icon chat-wa-btn" href="https://wa.me/<%= activeWa %>" target="_blank" rel="noopener" title="Message on WhatsApp"><i data-lucide="message-circle"></i></a>
              <% } %>
              <button class="chat-header-icon" title="More"><i data-lucide="more-vertical"></i></button>
            </div>
          </div>

          <div class="chat-messages" id="chatMessages">
            <div class="chat-date-separator">Today</div>
            <% if (activeThread.length > 0) { %>
              <% activeThread.forEach(m => {
                const mine = Number(m.senderId) === Number(user.id);
              %>
                <div class="chat-msg-row <%= mine ? 'outgoing' : 'incoming' %>">
                  <div class="chat-msg-bubble">
                    <span class="chat-msg-text"><%= m.content %></span>
                    <span class="chat-msg-time">
                      <%= new Date(m.createdAt).toLocaleTimeString('en-KE', { hour: '2-digit', minute: '2-digit' }) %>
                      <% if (mine) { %><i data-lucide="check-check" class="chat-msg-tick"></i><% } %>
                    </span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div style="text-align:center;color:var(--ink-soft);padding:3rem 1rem;">
                <p>No messages in this conversation yet.</p>
                <p style="font-size:0.82rem;margin-top:0.25rem;">Say hello to start the conversation.</p>
              </div>
            <% } %>
          </div>

          <div class="chat-input-area">
            <button class="chat-input-icon" title="Emoji"><i data-lucide="smile"></i></button>
            <input type="text" class="chat-input-field" id="chatInput" placeholder="Type a message" autocomplete="off" />
            <button class="chat-input-icon" title="Attach"><i data-lucide="paperclip"></i></button>
            <button class="chat-send-btn" id="sendBtn" title="Send"><i data-lucide="send"></i></button>
          </div>
        <% } else { %>
          <div class="chat-empty-msg" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:3rem 1rem;text-align:center;color:var(--ink-soft);">
            <i data-lucide="messages-square" style="width:48px;height:48px;opacity:0.35;margin-bottom:1rem;"></i>
            <h3 style="font-size:1.05rem;color:var(--ink-mid);margin-bottom:0.5rem;">Select a conversation</h3>
            <p style="font-size:0.875rem;max-width:260px;">Choose a conversation, or tap the pencil icon to find a buyer by phone number.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<!-- ── New Chat / Find by phone modal ───────────────────────────────── -->
<div class="new-chat-modal" id="newChatModal">
  <div class="new-chat-modal-card">
    <div class="new-chat-modal-head">
      <h4>New Message</h4>
      <button class="new-chat-modal-close" id="closeNewChat" title="Close">&times;</button>
    </div>
    <div class="new-chat-modal-body">
      <div class="chat-search" style="border:none;border-radius:8px;">
        <i data-lucide="search" class="chat-search-icon"></i>
        <input type="text" class="chat-search-input" id="newChatSearch" placeholder="Search by name or phone number e.g. 07xx…”" autocomplete="off" />
      </div>
      <div class="new-chat-hint"><i data-lucide="smartphone" style="width:14px;height:14px;"></i> Enter a buyer’s phone number to find and message them, or open WhatsApp directly.</div>
      <div class="new-chat-results" id="newChatResults">
        <div class="new-chat-empty">Start typing to search buyers by name or phone number…</div>
      </div>
    </div>
  </div>
</div>

<script>
  // ── WhatsApp helper ────────────────────────────────────────────────
  function waNumber(phone) {
    if (!phone) return '';
    let d = String(phone).replace(/[^\d]/g, '');
    if (d.startsWith('0')) d = '254' + d.slice(1);
    else if (d.length === 9) d = '254' + d;
    return d;
  }

  // ── New chat modal ────────────────────────────────────────────────
  const newChatBtn = document.getElementById('newChatBtn');
  const newChatModal = document.getElementById('newChatModal');
  const closeNewChat = document.getElementById('closeNewChat');
  const newChatSearch = document.getElementById('newChatSearch');
  const newChatResults = document.getElementById('newChatResults');

  function openNewChat() {
    if (!newChatModal) return;
    newChatModal.classList.add('open');
    if (newChatSearch) { newChatSearch.value = ''; newChatSearch.focus(); }
    if (newChatResults) newChatResults.innerHTML = '<div class="new-chat-empty">Start typing to search buyers by name or phone number…</div>';
  }
  function closeNewChatModal() {
    if (newChatModal) newChatModal.classList.remove('open');
  }
  if (newChatBtn) newChatBtn.addEventListener('click', openNewChat);
  if (closeNewChat) closeNewChat.addEventListener('click', closeNewChatModal);
  newChatModal && newChatModal.addEventListener('click', (e) => {
    if (e.target === newChatModal) closeNewChatModal();
  });

  let searchTimer = null;
  if (newChatSearch) {
    newChatSearch.addEventListener('input', () => {
      clearTimeout(searchTimer);
      const q = newChatSearch.value.trim();
      if (!q) {
        if (newChatResults) newChatResults.innerHTML = '<div class="new-chat-empty">Start typing to search buyers by name or phone number…</div>';
        return;
      }
      searchTimer = setTimeout(() => {
        fetch('/api/messages/users?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
          .then(r => r.json())
          .then(data => {
            if (!newChatResults) return;
            if (!data.success || !data.users.length) {
              newChatResults.innerHTML = '<div class="new-chat-empty">No users found. Try a different phone number or name.</div>';
              return;
            }
            newChatResults.innerHTML = data.users.map(u => {
              const wa = waNumber(u.phoneNumber);
              return `
                <div class="new-chat-result">
                  <div class="chat-thread-avatar">${(u.fullName || '?').charAt(0).toUpperCase()}</div>
                  <div class="new-chat-result-body">
                    <div class="new-chat-result-name">${u.fullName} <span class="new-chat-result-role">${u.role || ''}</span></div>
                    ${u.phoneNumber ? `<div class="chat-thread-phone"><i data-lucide="phone" style="width:11px;height:11px;"></i> ${u.phoneNumber}</div>` : ''}
                  </div>
                  <div class="new-chat-result-actions">
                    <a class="new-chat-msg-link" href="/messages/${u.id}"><i data-lucide="message-circle"></i> Message</a>
                    ${wa ? `<a class="new-chat-wa-link" href="https://wa.me/${wa}" target="_blank" rel="noopener"><i data-lucide="phone"></i> WhatsApp</a>` : ''}
                  </div>
                </div>`;
            }).join('');
            if (typeof lucide !== 'undefined') lucide.createIcons();
          })
          .catch(() => {
            if (newChatResults) newChatResults.innerHTML = '<div class="new-chat-empty">Something went wrong. Please try again.</div>';
          });
      }, 300);
    });
  }

  // ── Send message ──────────────────────────────────────────────
  const sendBtn = document.getElementById('sendBtn');
  const chatInput = document.getElementById('chatInput');
  const chatMessages = document.getElementById('chatMessages');

  function sendMessage() {
    if (!sendBtn || !chatInput || !chatInput.value.trim()) return;
    const content = chatInput.value.trim();
    const recipientId = <%- JSON.stringify(activeUserId || null) %>;
    if (!recipientId) return;

    fetch('/api/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || ''
      },
      body: JSON.stringify({ recipient_id: recipientId, content }),
    })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          chatInput.value = '';
          if (chatMessages) {
            const row = document.createElement('div');
            row.className = 'chat-msg-row outgoing';
            row.innerHTML = `
              <div class="chat-msg-bubble">
                <span class="chat-msg-text">${content}</span>
                <span class="chat-msg-time">Just now <i data-lucide="check-check" class="chat-msg-tick"></i></span>
              </div>`;
            chatMessages.appendChild(row);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            if (typeof lucide !== 'undefined') lucide.createIcons();
          }
        }
      })
      .catch(() => { /* ignore */ });
  }

  if (sendBtn) sendBtn.addEventListener('click', sendMessage);
  if (chatInput) {
    chatInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') sendMessage();
    });
  }

  // ── Search conversations ─────────────────────────────────────
  const chatSearch = document.getElementById('chatSearch');
  if (chatSearch) {
    chatSearch.addEventListener('input', () => {
      const q = chatSearch.value.toLowerCase();
      document.querySelectorAll('.chat-thread-item').forEach(item => {
        const name = item.querySelector('.chat-thread-name span').textContent.toLowerCase();
        item.style.display = name.includes(q) ? '' : 'none';
      });
    });
  }

  // Scroll to bottom on load
  if (chatMessages) {
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>

<%- include('partials/chatbot') %>
<%- include('partials/footer') %>
