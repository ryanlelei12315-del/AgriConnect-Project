<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="dash-main">
  <%- include('partials/sidebar', { currentPage: 'messages' }) %>

  <div class="dash-content" style="padding-top:2.5rem;">
    <div class="dash-header">
      <div>
        <h1 class="dash-greeting">Messages</h1>
        <p class="dash-sub">Chat directly with buyers, farmers and service providers.</p>
      </div>
    </div>

    <div class="chat-layout">
      <!-- ── Conversation List ─────────────────────────────────── -->
      <div class="chat-threads" id="conversationList">
        <% if (conversations && conversations.length > 0) { %>
          <% conversations.forEach(c => { %>
            <a href="/messages/<%= c.user.id %>" class="chat-thread-item <%= (activeUserId && Number(activeUserId) === Number(c.user.id)) ? 'active' : '' %>">
              <div class="chat-thread-avatar"><%= (c.user.fullName || '?').charAt(0).toUpperCase() %></div>
              <div class="chat-thread-details">
                <div class="chat-thread-name">
                  <span><%= c.user.fullName %></span>
                  <span class="chat-thread-time"><%= new Date(c.lastAt).toLocaleDateString('en-KE', { month: 'short', day: 'numeric' }) %></span>
                </div>
                <div class="chat-thread-preview"><%= c.lastMessage %></div>
              </div>
              <% if (Number(c.unread) > 0) { %>
                <span class="sidebar-badge sidebar-badge-green" style="flex-shrink:0;"><%= c.unread %></span>
              <% } %>
            </a>
          <% }) %>
        <% } else { %>
          <div class="chat-empty-msg" style="padding:2rem;text-align:center;color:var(--ink-soft);">
            <i data-lucide="message-square" style="width:36px;height:36px;opacity:0.4;margin-bottom:0.75rem;"></i>
            <p>No conversations yet.</p>
            <p style="font-size:0.82rem;margin-top:0.25rem;">When someone messages you, the conversation will appear here.</p>
          </div>
        <% } %>
      </div>

      <!-- ── Active Thread ─────────────────────────────────────── -->
      <div class="chat-box">
        <% if (activeUser && activeThread) { %>
          <div class="chat-header">
            <div class="chat-thread-avatar"><%= (activeUser.fullName || '?').charAt(0).toUpperCase() %></div>
            <div>
              <div class="chat-header-name"><%= activeUser.fullName %></div>
              <div class="chat-header-status">● Direct Message</div>
            </div>
          </div>

          <div class="chat-messages" id="chatMessages">
            <% if (activeThread.length > 0) { %>
              <% activeThread.forEach(m => {
                const mine = Number(m.senderId) === Number(user.id);
              %>
                <div class="chat-msg-bubble <%= mine ? 'outgoing' : 'incoming' %>">
                  <%= m.content %>
                  <div class="chat-msg-time"><%= new Date(m.createdAt).toLocaleTimeString('en-KE', { hour: '2-digit', minute: '2-digit' }) %></div>
                </div>
              <% }) %>
            <% } else { %>
              <div style="text-align:center;color:var(--ink-soft);padding:3rem 1rem;">
                <p>No messages in this conversation yet.</p>
                <p style="font-size:0.82rem;margin-top:0.25rem;">Say hello to start the conversation.</p>
              </div>
            <% } %>
          </div>

          <div class="chat-input-area">
            <input type="text" class="chat-input-field" id="chatInput" placeholder="Type a message…" autocomplete="off" />
            <button class="chat-send-btn" id="sendBtn">Send</button>
          </div>
        <% } else { %>
          <div class="chat-empty-msg" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:3rem 1rem;text-align:center;color:var(--ink-soft);">
            <i data-lucide="messages-square" style="width:48px;height:48px;opacity:0.35;margin-bottom:1rem;"></i>
            <h3 style="font-size:1.05rem;color:var(--ink-mid);margin-bottom:0.5rem;">Select a conversation</h3>
            <p style="font-size:0.875rem;max-width:260px;">Choose a conversation from the list to start chatting.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<script>
  // ── Send message ──────────────────────────────────────────────
  const sendBtn = document.getElementById('sendBtn');
  const chatInput = document.getElementById('chatInput');
  const chatMessages = document.getElementById('chatMessages');

  function sendMessage() {
    if (!sendBtn || !chatInput || !chatInput.value.trim()) return;
    const content = chatInput.value.trim();
    const recipientId = <%- JSON.stringify(activeUserId || null) %>;
    if (!recipientId) return;

    fetch('/api/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ recipient_id: recipientId, content }),
    })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          chatInput.value = '';
          if (chatMessages) {
            const d = document.createElement('div');
            d.className = 'chat-msg-bubble outgoing';
            d.innerHTML = content + '<div class="chat-msg-time">Just now</div>';
            chatMessages.appendChild(d);
            chatMessages.scrollTop = chatMessages.scrollHeight;
          }
        }
      })
      .catch(() => { /* ignore */ });
  }

  if (sendBtn) sendBtn.addEventListener('click', sendMessage);
  if (chatInput) {
    chatInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') sendMessage();
    });
  }

  // Scroll to bottom on load
  if (chatMessages) {
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  if (typeof lucide !== 'undefined') lucide.createIcons();
</script>

<%- include('partials/footer') %>