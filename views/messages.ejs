<%- include('partials/header') %>
<%- include('partials/navbar') %>

<style>
  /* ══ WHATSAPP WEB-STYLE MESSAGING LAYOUT ══ */
  .chat-layout {
    display: flex;
    height: calc(100vh - 120px);
    max-height: 850px;
    background: #0f172a;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .chat-threads {
    width: 340px;
    background: #1e293b;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    shrink: 0;
  }

  .chat-list-header {
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #0f172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .chat-list-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f8fafc;
  }
  .chat-list-icon {
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: #cbd5e1;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .chat-list-icon:hover {
    background: #059669;
    color: #fff;
  }

  .chat-search-wrap {
    padding: 0.75rem 1rem;
    background: #1e293b;
  }
  .chat-search {
    display: flex;
    align-items: center;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 0.4rem 0.85rem;
    gap: 0.5rem;
  }
  .chat-search-icon {
    color: #94a3b8;
    width: 16px;
    height: 16px;
  }
  .chat-search-input {
    background: transparent;
    border: none;
    color: #f8fafc;
    font-size: 0.875rem;
    width: 100%;
    outline: none;
  }
  .chat-search-input::placeholder {
    color: #64748b;
  }

  .chat-thread-list {
    flex: 1;
    overflow-y: auto;
  }
  .chat-thread-item {
    display: flex;
    align-items: center;
    padding: 0.85rem 1rem;
    gap: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .chat-thread-item:hover, .chat-thread-item.active {
    background: rgba(51, 65, 85, 0.7);
  }
  .chat-thread-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #059669;
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    shrink: 0;
  }
  .chat-thread-details {
    flex: 1;
    min-width: 0;
  }
  .chat-thread-name {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 600;
    color: #f8fafc;
    margin-bottom: 0.2rem;
  }
  .chat-thread-time {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 400;
  }
  .chat-thread-phone {
    font-size: 0.75rem;
    color: #fbbf24;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 0.25rem;
  }
  .chat-thread-preview-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .chat-thread-preview {
    font-size: 0.8rem;
    color: #94a3b8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
  .chat-unread-badge {
    background: #059669;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 10px;
    padding: 0.15rem 0.45rem;
  }

  /* Right Active Chat Window */
  .chat-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #090d16;
    position: relative;
  }
  .chat-header {
    padding: 0.85rem 1.25rem;
    background: #1e293b;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .chat-header-info {
    flex: 1;
  }
  .chat-header-name {
    font-weight: 700;
    color: #f8fafc;
    font-size: 1rem;
  }
  .chat-header-status {
    font-size: 0.75rem;
    color: #34d399;
  }
  .chat-header-actions {
    display: flex;
    gap: 0.5rem;
  }
  .chat-header-icon {
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: #cbd5e1;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
  }
  .chat-header-icon:hover {
    background: #334155;
    color: #fff;
  }

  .chat-messages {
    flex: 1;
    padding: 1.25rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: radial-gradient(circle at center, #111827 0%, #090d16 100%);
  }

  /* Micro-timestamps & Bubbles */
  .chat-msg-row {
    display: flex;
    width: 100%;
  }
  .chat-msg-row.outgoing {
    justify-content: flex-end;
  }
  .chat-msg-row.incoming {
    justify-content: flex-start;
  }
  .chat-msg-bubble {
    max-width: 65%;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    font-size: 0.9rem;
    line-height: 1.45;
    position: relative;
    word-break: break-word;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  }
  .chat-msg-row.outgoing .chat-msg-bubble {
    background: #15803d; /* Distinct readable green tint */
    color: #ffffff;
    border-bottom-right-radius: 4px;
  }
  .chat-msg-row.incoming .chat-msg-bubble {
    background: #334155; /* Dark slate receiver bubble */
    color: #f8fafc;
    border-bottom-left-radius: 4px;
  }

  .chat-msg-attachment {
    margin-top: 0.5rem;
    padding: 0.5rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .chat-msg-attachment img {
    max-width: 200px;
    max-height: 150px;
    border-radius: 6px;
    object-fit: cover;
  }
  .chat-msg-attachment-info {
    font-size: 0.8rem;
    color: #cbd5e1;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chat-msg-time {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 0.35rem;
  }
  .chat-msg-tick {
    width: 13px;
    height: 13px;
    color: #86efac;
  }

  /* Sticky Bottom Input Bar & Emojis */
  .chat-input-area-wrap {
    background: #1e293b;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
  }
  .attachment-preview-banner {
    display: none;
    padding: 0.6rem 1.25rem;
    background: #0f172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    align-items: center;
    justify-content: space-between;
  }
  .attachment-preview-banner.active {
    display: flex;
  }
  .attachment-preview-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #fbbf24;
    font-size: 0.85rem;
  }
  .attachment-preview-thumb {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    object-fit: cover;
    background: #334155;
  }
  .attachment-preview-remove {
    background: transparent;
    border: none;
    color: #ef4444;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .chat-input-area {
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .chat-input-icon {
    background: transparent;
    border: none;
    color: #94a3b8;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.2s;
  }
  .chat-input-icon:hover {
    color: #34d399;
    background: rgba(255, 255, 255, 0.05);
  }
  .chat-input-field {
    flex: 1;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 0.65rem 1.2rem;
    color: #f8fafc;
    font-size: 0.9rem;
    outline: none;
  }
  .chat-input-field:focus {
    border-color: #059669;
  }
  .chat-send-btn {
    background: #059669;
    border: none;
    color: #fff;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
  }
  .chat-send-btn:hover {
    background: #047857;
  }

  /* Emoji helper popover */
  .emoji-picker-popover {
    display: none;
    position: absolute;
    bottom: 75px;
    left: 20px;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 0.75rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    z-index: 100;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.4rem;
    width: 250px;
  }
  .emoji-picker-popover.active {
    display: grid;
  }
  .emoji-btn {
    background: transparent;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .emoji-btn:hover {
    background: #334155;
  }

  @media (max-width: 768px) {
    .chat-layout {
      flex-direction: column;
      height: calc(100vh - 100px);
    }
    .chat-threads {
      width: 100%;
      height: 40%;
    }
    .chat-box {
      height: 60%;
    }
  }
</style>

<main class="dash-main">
  <%- include('partials/sidebar', { currentPage: 'messages' }) %>

  <div class="dash-content" style="padding-top:1.5rem;">
    <div class="dash-header" style="margin-bottom:1rem;">
      <div>
        <h1 class="dash-greeting" style="font-size:1.5rem;">Messages</h1>
        <p class="dash-sub">Direct WhatsApp-style communications with farmers, buyers, and service providers.</p>
      </div>
    </div>

    <div class="chat-layout">
      <!-- ── Conversation List (Left) ────────────────────────── -->
      <div class="chat-threads" id="conversationList">
        <div class="chat-list-header">
          <span class="chat-list-title">Chats</span>
          <button class="chat-list-icon" id="newChatBtn" title="New chat by phone number"><i data-lucide="square-pen"></i></button>
        </div>
        <div class="chat-search-wrap">
          <div class="chat-search">
            <i data-lucide="search" class="chat-search-icon"></i>
            <input type="text" class="chat-search-input" id="chatSearch" placeholder="Search conversations..." />
          </div>
        </div>

        <div class="chat-thread-list">
          <% if (conversations && conversations.length > 0) { %>
            <% conversations.forEach(c => { %>
              <a href="/messages/<%= c.user.id %>" class="chat-thread-item <%= (activeUserId && Number(activeUserId) === Number(c.user.id)) ? 'active' : '' %>">
                <div class="chat-thread-avatar"><%= (c.user.fullName || '?').charAt(0).toUpperCase() %></div>
                <div class="chat-thread-details">
                  <div class="chat-thread-name">
                    <span><%= c.user.fullName %></span>
                    <span class="chat-thread-time"><%= new Date(c.lastAt).toLocaleDateString('en-KE', { month: 'short', day: 'numeric' }) %></span>
                  </div>
                  <% if (c.user.phoneNumber) { %>
                    <div class="chat-thread-phone"><i data-lucide="phone" style="width:11px;height:11px;"></i> <%= c.user.phoneNumber %></div>
                  <% } %>
                  <div class="chat-thread-preview-row">
                    <span class="chat-thread-preview"><%= c.lastMessage %></span>
                    <% if (Number(c.unread) > 0) { %>
                      <span class="chat-unread-badge"><%= c.unread %></span>
                    <% } %>
                  </div>
                </div>
              </a>
            <% }) %>
          <% } else { %>
            <div style="padding:2rem;text-align:center;color:#94a3b8;">
              <i data-lucide="message-square" style="width:36px;height:36px;opacity:0.4;margin-bottom:0.75rem;"></i>
              <p style="font-size:0.9rem;">No conversations yet.</p>
              <p style="font-size:0.8rem;margin-top:0.25rem;">Tap the pencil button above to search by phone number.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ── Active Thread Window (Right) ─────────────────────── -->
      <div class="chat-box">
        <% if (activeUser && activeThread) { %>
          <%
            let activeWa = '';
            if (activeUser.phoneNumber) {
              let p = String(activeUser.phoneNumber).replace(/[^\d]/g, '');
              if (p.startsWith('0')) p = '254' + p.slice(1);
              else if (p.length === 9) p = '254' + p;
              activeWa = p;
            }
          %>
          <div class="chat-header">
            <div class="chat-thread-avatar"><%= (activeUser.fullName || '?').charAt(0).toUpperCase() %></div>
            <div class="chat-header-info">
              <div class="chat-header-name"><%= activeUser.fullName %></div>
              <div class="chat-header-status"><% if (activeUser.phoneNumber) { %><%= activeUser.phoneNumber %><% } else { %>Online<% } %></div>
            </div>
            <div class="chat-header-actions">
              <% if (activeWa) { %>
                <a class="chat-header-icon" href="https://wa.me/<%= activeWa %>" target="_blank" rel="noopener" title="Message on WhatsApp"><i data-lucide="phone-call"></i></a>
              <% } %>
              <a href="/profile" class="chat-header-icon" title="View Profile"><i data-lucide="user"></i></a>
            </div>
          </div>

          <div class="chat-messages" id="chatMessages">
            <div style="text-align:center;margin:0.5rem 0;"><span style="background:rgba(255,255,255,0.06);color:#94a3b8;font-size:0.75rem;padding:0.25rem 0.75rem;border-radius:12px;">Encrypted AgriConnect Chat</span></div>
            <% if (activeThread.length > 0) { %>
              <% activeThread.forEach(m => {
                const mine = Number(m.senderId) === Number(user.id);
              %>
                <div class="chat-msg-row <%= mine ? 'outgoing' : 'incoming' %>">
                  <div class="chat-msg-bubble">
                    <span class="chat-msg-text"><%= m.content %></span>
                    <% if (m.attachmentUrl) { %>
                      <div class="chat-msg-attachment">
                        <% if (/\.(jpe?g|png|webp|gif)$/i.test(m.attachmentUrl)) { %>
                          <img src="<%= m.attachmentUrl %>" alt="Attachment" />
                        <% else { %>
                          <i data-lucide="file-text"></i>
                          <a href="<%= m.attachmentUrl %>" target="_blank" class="chat-msg-attachment-info">Attachment Document</a>
                        <% } %>
                      </div>
                    <% } %>
                    <span class="chat-msg-time">
                      <%= new Date(m.createdAt).toLocaleTimeString('en-KE', { hour: '2-digit', minute: '2-digit' }) %>
                      <% if (mine) { %><i data-lucide="check-check" class="chat-msg-tick"></i><% } %>
                    </span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div style="text-align:center;color:#94a3b8;padding:3rem 1rem;">
                <p>No messages in this conversation yet.</p>
                <p style="font-size:0.82rem;margin-top:0.25rem;">Send a message to begin trading.</p>
              </div>
            <% } %>
          </div>

          <!-- Bottom Sticky Input Panel -->
          <div class="chat-input-area-wrap">
            <!-- Attachment preview popup banner -->
            <div class="attachment-preview-banner" id="attachmentPreviewContainer">
              <div class="attachment-preview-info">
                <i data-lucide="paperclip"></i>
                <span id="attachmentFileName">Selected file</span>
              </div>
              <button type="button" class="attachment-preview-remove" id="clearAttachmentBtn" title="Remove attachment">&times;</button>
            </div>

            <!-- Emoji Picker Popover -->
            <div class="emoji-picker-popover" id="emojiPopover">
              <button type="button" class="emoji-btn">🌾</button>
              <button type="button" class="emoji-btn">🌽</button>
              <button type="button" class="emoji-btn">🥔</button>
              <button type="button" class="emoji-btn">🚜</button>
              <button type="button" class="emoji-btn">💰</button>
              <button type="button" class="emoji-btn">🚚</button>
              <button type="button" class="emoji-btn">📦</button>
              <button type="button" class="emoji-btn">👍</button>
              <button type="button" class="emoji-btn">😊</button>
              <button type="button" class="emoji-btn">🙏</button>
              <button type="button" class="emoji-btn">📞</button>
              <button type="button" class="emoji-btn">📍</button>
            </div>

            <div class="chat-input-area">
              <button type="button" class="chat-input-icon" id="emojiToggleBtn" title="Insert Emoji"><i data-lucide="smile"></i></button>
              <button type="button" class="chat-input-icon" id="attachmentBtn" title="Attach File"><i data-lucide="paperclip"></i></button>
              <input type="file" id="chatFileInput" style="display:none;" accept="image/*,.pdf,.doc,.docx" />
              <input type="text" class="chat-input-field" id="chatInput" placeholder="Type a message..." autocomplete="off" />
              <button type="button" class="chat-send-btn" id="sendBtn" title="Send Message"><i data-lucide="send"></i></button>
            </div>
          </div>
        <% } else { %>
          <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:3rem 1rem;text-align:center;color:#94a3b8;">
            <i data-lucide="messages-square" style="width:54px;height:54px;opacity:0.3;margin-bottom:1rem;color:#34d399;"></i>
            <h3 style="font-size:1.1rem;color:#f8fafc;margin-bottom:0.5rem;">Select a Conversation</h3>
            <p style="font-size:0.875rem;max-width:300px;color:#94a3b8;">Choose a conversation thread from the left menu or click the new message icon to find a user by phone number.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<!-- New Chat Modal -->
<div class="new-chat-modal" id="newChatModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:999;align-items:center;justify-content:center;">
  <div style="background:#1e293b;border:1px solid rgba(255,255,255,0.1);border-radius:12px;width:90%;max-width:440px;padding:1.25rem;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
      <h4 style="color:#f8fafc;margin:0;font-size:1.1rem;">New Message</h4>
      <button id="closeNewChat" style="background:none;border:none;color:#94a3b8;font-size:1.5rem;cursor:pointer;">&times;</button>
    </div>
    <input type="text" id="newChatSearch" class="chat-input-field" style="width:100%;margin-bottom:1rem;" placeholder="Search buyer or seller by name or phone..." />
    <div id="newChatResults" style="max-height:260px;overflow-y:auto;color:#cbd5e1;font-size:0.875rem;">
      Search by name or phone number e.g. 07xx...
    </div>
  </div>
</div>

<script>
  (function(){
    // Emoji Popover Toggle
    const emojiToggleBtn = document.getElementById('emojiToggleBtn');
    const emojiPopover = document.getElementById('emojiPopover');
    const chatInput = document.getElementById('chatInput');

    if (emojiToggleBtn && emojiPopover && chatInput) {
      emojiToggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        emojiPopover.classList.toggle('active');
      });
      document.querySelectorAll('.emoji-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          chatInput.value += this.textContent;
          chatInput.focus();
          emojiPopover.classList.remove('active');
        });
      });
      document.addEventListener('click', function(e) {
        if (!emojiPopover.contains(e.target) && e.target !== emojiToggleBtn) {
          emojiPopover.classList.remove('active');
        }
      });
    }

    // Attachment File Picker & Preview
    const attachmentBtn = document.getElementById('attachmentBtn');
    const chatFileInput = document.getElementById('chatFileInput');
    const attachmentPreviewContainer = document.getElementById('attachmentPreviewContainer');
    const attachmentFileName = document.getElementById('attachmentFileName');
    const clearAttachmentBtn = document.getElementById('clearAttachmentBtn');
    let selectedFile = null;

    if (attachmentBtn && chatFileInput) {
      attachmentBtn.addEventListener('click', function() {
        chatFileInput.click();
      });

      chatFileInput.addEventListener('change', function() {
        if (this.files && this.files[0]) {
          selectedFile = this.files[0];
          if (attachmentFileName) attachmentFileName.textContent = selectedFile.name;
          if (attachmentPreviewContainer) attachmentPreviewContainer.classList.add('active');
        }
      });

      if (clearAttachmentBtn) {
        clearAttachmentBtn.addEventListener('click', function() {
          selectedFile = null;
          chatFileInput.value = '';
          if (attachmentPreviewContainer) attachmentPreviewContainer.classList.remove('active');
        });
      }
    }

    // Search conversation threads
    const chatSearch = document.getElementById('chatSearch');
    if (chatSearch) {
      chatSearch.addEventListener('input', function() {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.chat-thread-item').forEach(item => {
          const text = item.textContent.toLowerCase();
          item.style.display = text.includes(q) ? 'flex' : 'none';
        });
      });
    }

    // New Chat Modal
    const newChatBtn = document.getElementById('newChatBtn');
    const newChatModal = document.getElementById('newChatModal');
    const closeNewChat = document.getElementById('closeNewChat');
    const newChatSearch = document.getElementById('newChatSearch');
    const newChatResults = document.getElementById('newChatResults');

    if (newChatBtn && newChatModal) {
      newChatBtn.addEventListener('click', function() {
        newChatModal.style.display = 'flex';
        if (newChatSearch) newChatSearch.focus();
      });
    }
    if (closeNewChat && newChatModal) {
      closeNewChat.addEventListener('click', function() {
        newChatModal.style.display = 'none';
      });
    }

    let searchTimer = null;
    if (newChatSearch && newChatResults) {
      newChatSearch.addEventListener('input', function() {
        clearTimeout(searchTimer);
        const q = this.value.trim();
        if (!q) {
          newChatResults.innerHTML = 'Search by name or phone number e.g. 07xx...';
          return;
        }
        searchTimer = setTimeout(function() {
          fetch('/api/messages/users?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
            .then(r => r.json())
            .then(data => {
              if (!data.success || !data.users.length) {
                newChatResults.innerHTML = '<div style="padding:0.5rem;color:#94a3b8;">No users found.</div>';
                return;
              }
              newChatResults.innerHTML = data.users.map(u => `
                <div style="display:flex;align-items:center;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);">
                  <div>
                    <strong style="color:#f8fafc;">${u.fullName}</strong>
                    <div style="font-size:0.75rem;color:#94a3b8;">${u.phoneNumber || ''} (${u.role || 'user'})</div>
                  </div>
                  <a href="/messages/${u.id}" class="btn btn-amber btn-sm" style="padding:0.25rem 0.6rem;font-size:0.75rem;text-decoration:none;">Chat</a>
                </div>
              `).join('');
            })
            .catch(() => {
              newChatResults.innerHTML = '<div style="padding:0.5rem;color:#ef4444;">Search failed.</div>';
            });
        }, 300);
      });
    }

    // Send Message Logic
    const sendBtn = document.getElementById('sendBtn');
    const chatMessages = document.getElementById('chatMessages');

    function escapeHtml(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function sendMessage() {
      if (!sendBtn || !chatInput) return;
      const content = (chatInput.value || '').trim();
      if (!content && !selectedFile) return;

      const recipientId = <%- JSON.stringify(activeUserId || null) %>;
      if (!recipientId) return;

      sendBtn.disabled = true;

      const payload = { recipient_id: recipientId, content: content };
      if (selectedFile) {
        payload.attachment_name = selectedFile.name;
      }

      fetch('/api/messages', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(r => r.json().then(d => ({ ok: r.ok, d })))
        .then(({ ok, d }) => {
          if (ok && d && d.success) {
            chatInput.value = '';
            if (clearAttachmentBtn) clearAttachmentBtn.click();
            if (chatMessages) {
              const row = document.createElement('div');
              row.className = 'chat-msg-row outgoing';
              let fileHtml = selectedFile ? `<div class="chat-msg-attachment"><i data-lucide="file"></i> <span>${escapeHtml(selectedFile.name)}</span></div>` : '';
              row.innerHTML = `
                <div class="chat-msg-bubble">
                  <span class="chat-msg-text">${escapeHtml(content)}</span>
                  ${fileHtml}
                  <span class="chat-msg-time">Just now <i data-lucide="check-check" class="chat-msg-tick"></i></span>
                </div>`;
              chatMessages.appendChild(row);
              chatMessages.scrollTop = chatMessages.scrollHeight;
              if (window.lucide) lucide.createIcons();
            }
          } else {
            alert((d && d.message) ? d.message : 'Failed to send message.');
          }
        })
        .catch(() => alert('Network error. Failed to send message.'))
        .finally(() => {
          sendBtn.disabled = false;
        });
    }

    if (sendBtn) sendBtn.addEventListener('click', sendMessage);
    if (chatInput) {
      chatInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });
    }

    if (chatMessages) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
  })();
</script>

