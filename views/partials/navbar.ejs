<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark"><i data-lucide="leaf"></i></div>
    <span class="nav-logo-text">Agri<em>Connect</em> KE</span>
  </a>
  <div class="nav-center">
    <a href="/marketplace">Marketplace</a>
    <a href="/services">Services</a>
    <a href="/market-prices">Market Prices</a>
    <a href="/why-us">Why Us</a>
  </div>
  <div class="nav-right" id="nav-right">
    <span class="nav-skeleton">Loading…</span>
  </div>
</nav>

<script>
  (function () {
    const el = document.getElementById('nav-right');

    // Check auth state server-side via the httpOnly cookie (no localStorage token).
    fetch('/api/auth/me', { credentials: 'same-origin' })
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (data && data.success) {
          const user = data.user;
          const role = user.role || 'farmer';

          el.innerHTML = `
          <a href="/dashboard" class="nav-user-chip">
            <span class="nav-user-avatar">${(user.full_name || '?').charAt(0).toUpperCase()}</span>
            <span class="nav-user-name">${(user.full_name || 'User').split(' ')[0]}</span>
          </a>
          <button class="btn btn-outline" id="logout-btn">Sign out</button>
        `;

          document.getElementById('logout-btn').addEventListener('click', async () => {
            try {
              await fetch('/api/auth/logout', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                  'x-csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '',
                },
              });
            } catch (e) {
              /* ignore */
            }
            window.location.href = '/';
          });
        } else {
          el.innerHTML = `
          <a href="/login" class="btn btn-outline">Sign in</a>
          <a href="/register" class="btn btn-amber">Join Free →</a>
        `;
        }
      })
      .catch(() => {
        el.innerHTML = `
        <a href="/login" class="btn btn-outline">Sign in</a>
        <a href="/register" class="btn btn-amber">Join Free →</a>
      `;
      });
  })();
</script>
