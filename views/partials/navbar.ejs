<!-- ══ NAV ══ -->
<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark"><i data-lucide="leaf"></i></div>
    <span class="nav-logo-text">Agri<em>Connect</em> KE</span>
  </a>
  <div class="nav-center">
    <a href="/marketplace">Marketplace</a>
    <a href="/services">Services</a>
    <a href="/#prices">Market Prices</a>
    <a href="/#why">Why Us</a>
  </div>
  <div class="nav-right" id="nav-right">
    <!-- Filled by auth-nav.js -->
  </div>
</nav>

<script>
(function () {
  const token = localStorage.getItem('agri_token');
  const user  = JSON.parse(localStorage.getItem('agri_user') || 'null');
  const el    = document.getElementById('nav-right');

  if (token && user) {
    // Logged-in state
    const role = user.role || 'farmer';
    const dash = role === 'buyer' ? '/dashboard/buyer'
               : role === 'provider' ? '/dashboard/provider'
               : '/dashboard';

    el.innerHTML = `
      <a href="${dash}" class="nav-user-chip">
        <span class="nav-user-avatar">${user.full_name.charAt(0).toUpperCase()}</span>
        <span class="nav-user-name">${user.full_name.split(' ')[0]}</span>
      </a>
      <button class="btn btn-outline" id="logout-btn">Sign out</button>
    `;
    document.getElementById('logout-btn').addEventListener('click', () => {
      localStorage.removeItem('agri_token');
      localStorage.removeItem('agri_user');
      window.location.href = '/';
    });
  } else {
    // Guest state
    el.innerHTML = `
      <a href="/login" class="btn btn-outline">Sign in</a>
      <a href="/register" class="btn btn-amber">Join Free →</a>
    `;
  }
})();
</script>
