<!-- Primary public navigation. Authenticated state is server-rendered. -->
<nav aria-label="Primary navigation">
  <a href="/" class="nav-logo" aria-label="AgriConnect KE home">
    <span class="nav-logo-mark"><i data-lucide="leaf" aria-hidden="true"></i></span>
    <span class="nav-logo-text">Agri<em>Connect</em> KE</span>
  </a>
  <div class="nav-center">
    <a href="/marketplace">Marketplace</a>
    <a href="/services">Services</a>
    <a href="/market-prices">Market prices</a>
    <a href="/why-us">How it works</a>
  </div>
  <div class="nav-right">
    <button type="button" class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" title="Toggle dark mode">
      <svg class="theme-icon-sun" style="width:18px;height:18px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      <svg class="theme-icon-moon" style="width:18px;height:18px; display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="nav-user-chip" aria-label="Open your dashboard">
        <span class="nav-user-avatar"><%= (user.fullName || user.full_name || '?').charAt(0).toUpperCase() %></span>
        <span class="nav-user-name"><%= (user.fullName || user.full_name || 'User').split(' ')[0] %></span>
      </a>
      <form action="/api/auth/logout" method="POST" style="display:inline;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button class="btn btn-outline" type="submit">Sign out</button>
      </form>
    <% } else { %>
      <a href="/login" class="btn btn-outline">Sign in</a>
      <a href="/register" class="btn btn-amber">Join free</a>
    <% } %>
  </div>
</nav>
