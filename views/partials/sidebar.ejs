<!-- ══ SIDEBAR ══ -->
<% const navId = (typeof activeNav !== 'undefined' && activeNav) ? activeNav : (typeof currentPage === 'string' ? currentPage : ''); %>
<!-- Mobile hamburger toggle -->
<button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="dashSidebar">
  <i data-lucide="menu"></i>
</button>
<!-- Overlay for mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="dash-sidebar" id="dashSidebar">

  <!-- ── Brand ─────────────────────────────────────────────────── -->
  <div class="sidebar-brand">
    <a href="/dashboard" class="sidebar-brand-logo">
      <i data-lucide="leaf" style="width:22px;height:22px;"></i>
      Agri<em>Connect</em>
    </a>
  </div>

  <!-- ── Navigation (grouped) ──────────────────────────────────── -->
  <nav class="sidebar-nav" aria-label="Application Navigation">

    <div class="nav-group">
      <div class="nav-group-label">Core</div>
      <a href="/dashboard" class="sidebar-link <%= navId === 'dashboard' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="layout-dashboard"></i></span>
        <span class="sidebar-link-text">Dashboard</span>
      </a>
    </div>

    <div class="nav-group">
      <div class="nav-group-label">Operations</div>

      <% if (typeof user !== 'undefined' && user && user.role === 'farmer') { %>
      <a href="/produce" class="sidebar-link <%= navId === 'produce' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="box"></i></span>
        <span class="sidebar-link-text">My Produce</span>
      </a>
      <% } %>

      <a href="/orders" class="sidebar-link <%= navId === 'orders' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="shopping-bag"></i></span>
        <span class="sidebar-link-text">Orders</span>
        <% if (typeof pendingOrdersCount !== 'undefined' && pendingOrdersCount > 0) { %>
          <span class="sidebar-badge sidebar-badge-amber"><%= pendingOrdersCount %></span>
        <% } %>
      </a>

      <% if (typeof user !== 'undefined' && user && user.role !== 'farmer') { %>
      <a href="/services/requests/mine" class="sidebar-link <%= navId === 'requests' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="clipboard-list"></i></span>
        <span class="sidebar-link-text">Service Requests</span>
      </a>
      <% } %>
    </div>

    <div class="nav-group">
      <div class="nav-group-label">Marketplace</div>
      <a href="/marketplace" class="sidebar-link <%= navId === 'marketplace' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="store"></i></span>
        <span class="sidebar-link-text">Marketplace</span>
      </a>
      <a href="/services" class="sidebar-link <%= navId === 'services' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="tractor"></i></span>
        <span class="sidebar-link-text">Services</span>
      </a>
      <a href="/market-prices" class="sidebar-link <%= navId === 'market-prices' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="bar-chart-2"></i></span>
        <span class="sidebar-link-text">Market Prices</span>
      </a>
    </div>

    <div class="nav-group">
      <div class="nav-group-label">Communication</div>
      <a href="/messages" class="sidebar-link <%= navId === 'messages' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="message-square"></i></span>
        <span class="sidebar-link-text">Messages</span>
        <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
          <span class="sidebar-badge sidebar-badge-green"><%= unreadMessagesCount %></span>
        <% } %>
      </a>
      <a href="/notifications" class="sidebar-link <%= navId === 'notifications' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="bell"></i></span>
        <span class="sidebar-link-text">Notifications</span>
        <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
          <span class="sidebar-badge sidebar-badge-red"><%= unreadNotificationsCount %></span>
        <% } %>
      </a>
    </div>

    <div class="nav-group">
      <div class="nav-group-label">Account</div>
      <a href="/profile" class="sidebar-link <%= navId === 'profile' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="user"></i></span>
        <span class="sidebar-link-text">Profile</span>
      </a>
      <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
      <a href="/admin" class="sidebar-link <%= navId === 'admin' ? 'active' : '' %>">
        <span class="sidebar-link-icon"><i data-lucide="shield"></i></span>
        <span class="sidebar-link-text">Admin Panel</span>
      </a>
      <% } %>
    </div>

  </nav>

  <!-- ── User area (bottom) ───────────────────────────────────── -->
  <div class="sidebar-userarea" id="sidebarUserArea">
    <% if (typeof user !== 'undefined' && user) { %>
      <button type="button" class="sidebar-user-btn" id="sidebarUserBtn" aria-haspopup="true" aria-expanded="false">
        <span class="sidebar-avatar"><%= (user.fullName || user.full_name || '?').charAt(0).toUpperCase() %></span>
        <span>
          <span class="sua-name"><%= user.fullName || user.full_name || 'User' %></span>
          <span class="sua-role"><%= user.role === 'farmer' ? 'Farmer' : user.role === 'buyer' ? 'Buyer' : user.role === 'provider' ? 'Service Provider' : user.role === 'admin' ? 'Administrator' : user.role %></span>
        </span>
        <i data-lucide="chevron-up" class="sua-chevron"></i>
      </button>
      <div class="sidebar-user-menu" role="menu">
        <a href="/profile" role="menuitem"><i data-lucide="user"></i> Profile</a>
        <button type="button" id="sidebarThemeToggle" role="menuitem"><i data-lucide="moon"></i> Toggle theme</button>
        <div class="menu-sep"></div>
        <button type="button" id="sidebarSignoutBtn" class="menu-danger" role="menuitem"><i data-lucide="log-out"></i> Sign out</button>
      </div>
    <% } else { %>
      <div class="sidebar-guest-links">
        <a href="/login" class="btn btn-secondary btn-sm">Sign in</a>
        <a href="/register" class="btn btn-primary btn-sm">Join</a>
      </div>
    <% } %>
  </div>

  <!-- ── Collapse Toggle (desktop) ──────────────────────────────── -->
  <button class="sidebar-collapse-toggle" id="sidebarCollapseToggle" aria-label="Toggle sidebar">
    <i data-lucide="panel-left-close"></i>
    <span>Collapse</span>
  </button>

</aside>

<script>
  (function () {
    const toggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('dashSidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const COLLAPSE_KEY = 'agriSidebarCollapsed';

    function isMobileOpen() { return sidebar.classList.contains('open'); }
    var lastFocused = null;
    function getFocusable() {
      return Array.prototype.slice.call(
        sidebar.querySelectorAll('a[href], button:not([disabled])')
      );
    }

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
      lastFocused = document.activeElement;
      const first = getFocusable()[0];
      if (first) first.focus();
    }
    function closeSidebar(refocus) {
      if (!isMobileOpen()) return;
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      if (refocus && lastFocused && lastFocused.focus) lastFocused.focus();
    }

    if (toggle) toggle.addEventListener('click', openSidebar);
    if (overlay) overlay.addEventListener('click', function () { closeSidebar(true); });
    window.addEventListener('resize', function () { if (window.innerWidth > 900) closeSidebar(false); });

    // Desktop collapse (persisted across pages)
    const collapseToggle = document.getElementById('sidebarCollapseToggle');
    function applyCollapsed(collapsed) {
      document.body.classList.toggle('sidebar-collapsed', collapsed);
      sidebar.classList.toggle('collapsed', collapsed);
      const icon = collapseToggle.querySelector('i');
      if (icon) icon.setAttribute('data-lucide', collapsed ? 'panel-left-open' : 'panel-left-close');
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }
    if (collapseToggle) {
      if (localStorage.getItem(COLLAPSE_KEY) === '1') applyCollapsed(true);
      collapseToggle.addEventListener('click', function () {
        const next = !document.body.classList.contains('sidebar-collapsed');
        applyCollapsed(next);
        localStorage.setItem(COLLAPSE_KEY, next ? '1' : '0');
      });
    }

    // User menu
    const userArea = document.getElementById('sidebarUserArea');
    const userBtn = document.getElementById('sidebarUserBtn');
    function closeUserMenu() {
      userArea.classList.remove('open');
      userBtn.setAttribute('aria-expanded', 'false');
    }
    if (userBtn && userArea) {
      userBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        const open = userArea.classList.toggle('open');
        userBtn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', function (e) {
        if (!userArea.contains(e.target)) closeUserMenu();
      });
    }

    // Escape closes the user menu first, then the mobile drawer (focus restored).
    // Tab is trapped inside the open mobile drawer so focus cannot reach the
    // page behind the overlay.
    document.addEventListener('keydown', function (e) {
      if (userArea && userArea.classList.contains('open')) {
        if (e.key === 'Escape') {
          closeUserMenu();
          userBtn.focus();
        }
        return;
      }
      if (!isMobileOpen()) return;
      if (e.key === 'Escape') { closeSidebar(true); return; }
      if (e.key !== 'Tab') return;
      const focusable = getFocusable();
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && (document.activeElement === first || !sidebar.contains(document.activeElement))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (document.activeElement === last || !sidebar.contains(document.activeElement))) {
        e.preventDefault();
        first.focus();
      }
    });

    // Sign out (the global fetch patch injects the CSRF header)
    const signoutBtn = document.getElementById('sidebarSignoutBtn');
    if (signoutBtn) {
      signoutBtn.addEventListener('click', async function () {
        try {
          await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' });
        } catch (e) { /* ignore */ }
        window.location.href = '/';
      });
    }

    // Theme toggle (delegates to the shared data-theme-toggle logic in header.ejs)
    const themeBtn = document.getElementById('sidebarThemeToggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        const anyThemeBtn = document.querySelector('[data-theme-toggle]');
        if (anyThemeBtn) anyThemeBtn.click();
      });
    }
  })();
</script>
