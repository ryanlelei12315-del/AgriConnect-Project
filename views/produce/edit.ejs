<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="dash-main">
  <%- include('../partials/sidebar', { currentPage: 'produce' }) %>

  <div class="dash-content">
    <div class="dash-topbar">
      <div>
        <h1 class="dash-greeting">Edit Produce</h1>
        <p class="dash-sub">Update your listing details.</p>
      </div>
      <div class="dash-header-actions">
        <a href="/produce/<%= listing.id %>" class="btn btn-outline">Cancel</a>
      </div>
    </div>

    <div class="dash-section">
      <div class="produce-form-card">
        <form action="/produce/<%= listing.id %>/update" method="POST" class="produce-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-row">
            <div class="form-group">
              <label for="name" class="form-label">Produce Name *</label>
              <input type="text" id="name" name="name" class="form-input" required value="<%= listing.name %>">
            </div>
            <div class="form-group">
              <label for="category" class="form-label">Category *</label>
              <select id="category" name="category" class="form-input" required>
                <option value="Cereals" <%= listing.category === 'Cereals' ? 'selected' : '' %>>Cereals</option>
                <option value="Vegetables" <%= listing.category === 'Vegetables' ? 'selected' : '' %>>Vegetables</option>
                <option value="Fruits" <%= listing.category === 'Fruits' ? 'selected' : '' %>>Fruits</option>
                <option value="Legumes" <%= listing.category === 'Legumes' ? 'selected' : '' %>>Legumes</option>
                <option value="Root Crops" <%= listing.category === 'Root Crops' ? 'selected' : '' %>>Root Crops</option>
                <option value="Dairy" <%= listing.category === 'Dairy' ? 'selected' : '' %>>Dairy</option>
                <option value="Poultry" <%= listing.category === 'Poultry' ? 'selected' : '' %>>Poultry</option>
                <option value="Livestock" <%= listing.category === 'Livestock' ? 'selected' : '' %>>Livestock</option>
                <option value="Other" <%= listing.category === 'Other' ? 'selected' : '' %>>Other</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="unit" class="form-label">Unit *</label>
              <select id="unit" name="unit" class="form-input" required>
                <option value="kg" <%= listing.unit === 'kg' ? 'selected' : '' %>>Kilogram (kg)</option>
                <option value="bag" <%= listing.unit === 'bag' ? 'selected' : '' %>>Bag</option>
                <option value="crate" <%= listing.unit === 'crate' ? 'selected' : '' %>>Crate</option>
                <option value="bunch" <%= listing.unit === 'bunch' ? 'selected' : '' %>>Bunch</option>
                <option value="litre" <%= listing.unit === 'litre' ? 'selected' : '' %>>Litre</option>
                <option value="piece" <%= listing.unit === 'piece' ? 'selected' : '' %>>Piece</option>
              </select>
            </div>
            <div class="form-group">
              <label for="quantity" class="form-label">Quantity *</label>
              <input type="number" id="quantity" name="quantity" class="form-input" min="0.1" step="0.1" required value="<%= Number(listing.quantityKg) %>">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="price" class="form-label">Price (KES per <span id="priceUnitLabel"><%= listing.unit || 'kg' %></span>) *</label>
              <input type="number" id="price" name="price" class="form-input" min="1" step="0.01" required value="<%= Number(listing.pricePerKgKes) %>">
            </div>
            <div class="form-group">
              <label for="location" class="form-label">Location (County) *</label>
              <select id="location" name="location" class="form-input" required>
                <option value="Uasin Gishu" <%= listing.county === 'Uasin Gishu' ? 'selected' : '' %>>Uasin Gishu</option>
                <option value="Nakuru" <%= listing.county === 'Nakuru' ? 'selected' : '' %>>Nakuru</option>
                <option value="Trans Nzoia" <%= listing.county === 'Trans Nzoia' ? 'selected' : '' %>>Trans Nzoia</option>
                <option value="Meru" <%= listing.county === 'Meru' ? 'selected' : '' %>>Meru</option>
                <option value="Kiambu" <%= listing.county === 'Kiambu' ? 'selected' : '' %>>Kiambu</option>
                <option value="Kajiado" <%= listing.county === 'Kajiado' ? 'selected' : '' %>>Kajiado</option>
                <option value="Nairobi" <%= listing.county === 'Nairobi' ? 'selected' : '' %>>Nairobi</option>
                <option value="Mombasa" <%= listing.county === 'Mombasa' ? 'selected' : '' %>>Mombasa</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="status" class="form-label">Status *</label>
              <select id="status" name="status" class="form-input" required>
                <option value="LISTED" <%= listing.status === 'LISTED' ? 'selected' : '' %>>Active</option>
                <option value="PENDING" <%= listing.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
                <option value="SOLD" <%= listing.status === 'SOLD' ? 'selected' : '' %>>Sold</option>
                <option value="INACTIVE" <%= listing.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="description" class="form-label">Description</label>
            <textarea id="description" name="description" class="form-input" rows="4"><%= listing.description %></textarea>
          </div>

          <div class="form-actions">
            <a href="/produce/<%= listing.id %>" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-amber">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<script>
  lucide.createIcons();
  (function() {
    var unitSelect = document.getElementById('unit');
    var priceUnitLabel = document.getElementById('priceUnitLabel');
    if (unitSelect && priceUnitLabel) {
      unitSelect.addEventListener('change', function() {
        priceUnitLabel.textContent = unitSelect.value;
      });
    }
  })();
</script>

<%- include('../partials/footer') %>
