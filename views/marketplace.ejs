<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="page-container">
  <div class="page-header">
    <div class="page-header-text">
      <span class="page-eyebrow">Marketplace</span>
      <h1 class="page-title">Fresh Farm Produce</h1>
      <p class="page-subtitle">Buy directly from Kenyan farmers. Transparent prices, fresh quality, no middlemen.</p>
    </div>
    <% if (typeof user !== 'undefined' && user && user.role === 'farmer') { %>
      <div class="page-header-actions">
        <a href="/produce/new" class="btn btn-amber"><i data-lucide="plus"></i> Post Produce</a>
      </div>
    <% } %>
  </div>

  <form action="/marketplace" method="GET" class="filter-bar">
    <div>
      <input type="text" name="search" placeholder="Search produce..." value="<%= search %>" class="form-input">
    </div>
    <div>
      <select name="category" class="form-input">
        <option value="All" <%= category === 'All' ? 'selected' : '' %>>All Categories</option>
        <option value="Cereals" <%= category === 'Cereals' ? 'selected' : '' %>>Cereals</option>
        <option value="Vegetables" <%= category === 'Vegetables' ? 'selected' : '' %>>Vegetables</option>
        <option value="Fruits" <%= category === 'Fruits' ? 'selected' : '' %>>Fruits</option>
        <option value="Root Crops" <%= category === 'Root Crops' ? 'selected' : '' %>>Root Crops</option>
        <option value="Legumes" <%= category === 'Legumes' ? 'selected' : '' %>>Legumes</option>
        <option value="Dairy" <%= category === 'Dairy' ? 'selected' : '' %>>Dairy</option>
        <option value="Poultry" <%= category === 'Poultry' ? 'selected' : '' %>>Poultry</option>
      </select>
    </div>
    <div>
      <select name="county" class="form-input">
        <option value="All" <%= county === 'All' ? 'selected' : '' %>>All Counties</option>
        <option value="Uasin Gishu" <%= county === 'Uasin Gishu' ? 'selected' : '' %>>Uasin Gishu</option>
        <option value="Nakuru" <%= county === 'Nakuru' ? 'selected' : '' %>>Nakuru</option>
        <option value="Meru" <%= county === 'Meru' ? 'selected' : '' %>>Meru</option>
        <option value="Kajiado" <%= county === 'Kajiado' ? 'selected' : '' %>>Kajiado</option>
        <option value="Kiambu" <%= county === 'Kiambu' ? 'selected' : '' %>>Kiambu</option>
        <option value="Nairobi" <%= county === 'Nairobi' ? 'selected' : '' %>>Nairobi</option>
        <option value="Mombasa" <%= county === 'Mombasa' ? 'selected' : '' %>>Mombasa</option>
        <option value="Trans Nzoia" <%= county === 'Trans Nzoia' ? 'selected' : '' %>>Trans Nzoia</option>
      </select>
    </div>
    <button type="submit" class="btn btn-emerald">Search</button>
  </form>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (listings && listings.length > 0) { %>
    <div class="product-grid">
      <% listings.forEach(listing => { %>
        <div class="product-card">
          <div class="product-card-media">
            <% if (listing.imageUrl) { %>
              <img src="<%= listing.imageUrl %>" alt="<%= listing.name %>">
            <% } else { %>
              <span class="ph-icon"><i data-lucide="image"></i></span>
            <% } %>
            <span class="product-card-badge"><%= listing.category %></span>
          </div>
          <div class="product-card-body">
            <h3 class="product-card-title"><%= listing.name %></h3>
            <div class="product-card-meta"><i data-lucide="map-pin"></i> <%= listing.county %><%= listing.farmer ? ' · ' + listing.farmer.fullName : '' %></div>
            <div class="product-card-foot">
              <div class="product-card-price">KES <%= Number(listing.pricePerKgKes).toLocaleString() %><small>per kg</small></div>
              <div class="product-card-qty"><%= Number(listing.quantityKg).toLocaleString() %><small>kg available</small></div>
            </div>
            <div class="product-card-actions">
              <a href="/produce/<%= listing.id %>" class="btn btn-outline btn-block">View Details</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="/marketplace?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>&category=<%= encodeURIComponent(category) %>&county=<%= encodeURIComponent(county) %>" class="btn btn-outline btn-sm">← Previous</a>
        <% } else { %>
          <span class="btn btn-outline btn-sm" style="opacity:0.5; cursor:not-allowed;">← Previous</span>
        <% } %>

        <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>

        <% if (currentPage < totalPages) { %>
          <a href="/marketplace?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>&category=<%= encodeURIComponent(category) %>&county=<%= encodeURIComponent(county) %>" class="btn btn-outline btn-sm">Next →</a>
        <% } else { %>
          <span class="btn btn-outline btn-sm" style="opacity:0.5; cursor:not-allowed;">Next →</span>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <i data-lucide="search-x"></i>
      <h3>No produce found</h3>
      <p>We couldn't find any listings matching your search criteria.</p>
      <a href="/marketplace" class="btn btn-outline">Clear Filters</a>
    </div>
  <% } %>
</main>

<script>
  if (window.lucide) lucide.createIcons();
</script>

<%- include('partials/footer') %>
