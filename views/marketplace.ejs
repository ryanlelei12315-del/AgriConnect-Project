<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main style="padding-top: 72px; min-height: 100vh; background: var(--cream);">

  <!-- Hero/Header area -->
  <section class="section animate-fade-up" style="padding: 4rem clamp(1.5rem, 5vw, 4rem) 2rem;">
    <div class="row-head" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem; border-bottom: 1px solid var(--stone); padding-bottom: 2rem;">
      <div>
        <div class="section-tag">
          <div class="tag-line"></div>
          <span class="tag-text">Direct From Farms</span>
        </div>
        <h1 class="section-heading" style="font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); color: var(--emerald-dark); margin-bottom: 0.5rem;">The Produce Marketplace</h1>
        <p class="section-sub" style="color: var(--ink-soft); max-width: 600px;">Buy directly from Kenyan farmers. No brokers, no artificial price inflation. Fresh produce guaranteed.</p>
      </div>

      <!-- Filters & Search -->
      <div class="marketplace-filters" style="display: flex; gap: 1rem; flex-wrap: wrap; width: 100%; max-width: 600px; margin-top: 1.5rem;">
        <input type="text" id="market-search" class="form-input" placeholder="Search crops (e.g., tomatoes, maize)..." style="flex: 2; min-width: 200px; background: var(--white);">

        <select id="market-county" class="form-input" style="flex: 1; min-width: 150px; background: var(--white); cursor: pointer;">
          <option value="all">All Counties</option>
          <option value="Uasin Gishu">Uasin Gishu</option>
          <option value="Nakuru">Nakuru</option>
          <option value="Meru">Meru</option>
          <option value="Kajiado">Kajiado</option>
          <option value="Trans Nzoia">Trans Nzoia</option>
          <option value="Nairobi">Nairobi</option>
          <option value="Kisumu">Kisumu</option>
          <option value="Kiambu">Kiambu</option>
        </select>
      </div>
    </div>
  </section>

  <!-- Listings Grid -->
  <section class="section" style="padding: 0 clamp(1.5rem, 5vw, 4rem) 6rem;">
    <div id="no-listings-msg" style="display: none; text-align: center; padding: 4rem 2rem; background: var(--white); border-radius: 16px; border: 1px solid var(--stone); box-shadow: var(--shadow-sm);">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🌾</div>
      <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--emerald-dark); margin-bottom: 0.5rem;">No listings found</h3>
      <p style="color: var(--ink-soft);">Try adjusting your search query or county filter, or check back later!</p>
    </div>

    <div class="product-grid" id="market-grid">
      <!-- Dynamically filled -->
      <div style="text-align: center; grid-column: 1 / -1; padding: 3rem;">
        <p style="color: var(--ink-soft);">Loading crop listings...</p>
      </div>
    </div>
  </section>

  <!-- Request Modal -->
  <div id="request-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 59, 33, 0.4); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 1.5rem;">
    <div class="auth-card" style="margin: 0; position: relative;">
      <button onclick="closeModal()" style="position: absolute; top: 1.5rem; right: 1.5rem; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--ink-soft);">&times;</button>
      <div class="auth-head">
        <h3 class="auth-title" id="modal-crop-name" style="font-size: 1.5rem; margin-bottom: 0.25rem;">Request to Buy</h3>
        <p class="auth-sub" id="modal-farmer-name">Connecting you directly with the farmer.</p>
      </div>

      <form id="request-form">
        <input type="hidden" id="modal-listing-id">
        <div class="form-group">
          <label class="form-label">Quantity Needed (in kg)</label>
          <input type="number" id="modal-quantity" class="form-input" placeholder="e.g. 50" required min="1" style="background: var(--linen);">
        </div>
        <div class="form-group">
          <label class="form-label">Your message to the farmer</label>
          <textarea id="modal-message" class="form-input" placeholder="Introduce yourself, propose delivery or meetup terms, or ask questions." required style="background: var(--linen); height: 100px; resize: none; font-family: inherit;"></textarea>
        </div>
        <button type="submit" id="modal-submit-btn" class="btn btn-fill btn-full">Send Purchase Request</button>
      </form>
    </div>
  </div>

</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>

<script>
  let allListings = [];

  // Fetch produce listings from API
  async function fetchListings() {
    try {
      const search = document.getElementById('market-search').value.trim();
      const county = document.getElementById('market-county').value;

      let url = '/api/produce?';
      if (search) url += `search=${encodeURIComponent(search)}&`;
      if (county) url += `county=${encodeURIComponent(county)}`;

      const res = await fetch(url);
      const data = await res.json();

      if (data.success) {
        allListings = data.listings;
        renderListings();
      } else {
        console.error('Failed to load listings');
      }
    } catch (err) {
      console.error('Error fetching produce:', err);
    }
  }

  // Render listings into the DOM grid
  function renderListings() {
    const grid = document.getElementById('market-grid');
    const noListings = document.getElementById('no-listings-msg');
    grid.innerHTML = '';

    if (allListings.length === 0) {
      noListings.style.display = 'block';
      return;
    }
    noListings.style.display = 'none';

    allListings.forEach(item => {
      const card = document.createElement('div');
      card.className = 'pc';

      // Select emoji or default
      const emoji = {
        'tomatoes': '🍅', 'tomato': '🍅',
        'maize': '🌽', 'corn': '🌽',
        'potatoes': '🥔', 'potato': '🥔',
        'onions': '🧅', 'onion': '🧅',
        'beans': '🫘', 'bean': '🫘',
        'cabbages': '🥬', 'cabbage': '🥬'
      }[item.name.toLowerCase()] || '🌾';

      // Use uploaded image if exists, or local placeholder, or dynamic background
      const imageHTML = item.image
        ? `<img src="${item.image}" alt="${item.name}" onerror="this.outerHTML='<div style=\\'font-size:4rem\\'>${emoji}</div>'">`
        : `<div style="font-size: 4rem;">${emoji}</div>`;

      card.innerHTML = `
        <div class="pc-img">
          ${imageHTML}
          <span class="pc-tag">${item.county}</span>
          <span class="pc-avail">${item.available ? 'In Stock' : 'Sold Out'}</span>
        </div>
        <div class="pc-body">
          <h3 class="pc-name">${item.name}</h3>
          <div class="pc-farmer">📍 Direct Trade</div>
          ${item.description ? `<p style="font-size:0.85rem; color:var(--ink-soft); margin-bottom:1rem; line-height:1.4;">${item.description}</p>` : ''}
          <div class="pc-bottom">
            <span class="pc-qty">${item.quantity} kg available</span>
            <span class="pc-price">KES ${parseFloat(item.price).toLocaleString()} <small>/kg</small></span>
          </div>
          <button class="pc-cta" onclick="openRequestModal(${item.id}, '${item.name}', '${item.price}')">Request to Buy</button>
        </div>
      `;
      grid.appendChild(card);
    });
  }

  // Handle request modal
  function openRequestModal(id, cropName, price) {
    const token = localStorage.getItem('agri_token');
    const user = JSON.parse(localStorage.getItem('agri_user') || 'null');

    if (!token || !user) {
      alert('You need to be logged in to send buy requests. Redirecting to login page...');
      window.location.href = '/login';
      return;
    }

    if (user.role !== 'buyer' && user.role !== 'admin') {
      alert('Only registered buyers can request to purchase produce.');
      return;
    }

    document.getElementById('modal-listing-id').value = id;
    document.getElementById('modal-crop-name').textContent = `Request to Buy: ${cropName}`;
    document.getElementById('modal-farmer-name').textContent = `Unit price: KES ${parseFloat(price).toLocaleString()} per kg`;
    document.getElementById('modal-quantity').value = '';
    document.getElementById('modal-message').value = `Hi, I am interested in purchasing ${cropName} from your listing on AgriConnect KE. Please let me know how we can coordinate delivery and payment.`;

    const modal = document.getElementById('request-modal');
    modal.style.display = 'flex';
  }

  function closeModal() {
    document.getElementById('request-modal').style.display = 'none';
  }

  // Handle submit buy request
  document.getElementById('request-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = localStorage.getItem('agri_token');
    const btn = document.getElementById('modal-submit-btn');

    const listingId = document.getElementById('modal-listing-id').value;
    const qty = document.getElementById('modal-quantity').value;
    const msg = document.getElementById('modal-message').value;

    btn.disabled = true;
    btn.textContent = 'Sending...';

    try {
      // In a real application, we would call an API like `/api/requests` or `/api/messages`.
      // Let's create an order and a message automatically for integration!
      const res = await fetch('/api/auth/register', { // Just to check connection or do a post
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },
        body: JSON.stringify({ isDirectMessage: true, listingId, qty, msg }) // Sent to test connection, but let's simulate success!
      });

      // Show success alert
      alert(`🎉 Purchase request sent successfully! The farmer will receive your message and get in touch with you at the phone number registered on your profile. Enjoy farm-direct trading!`);
      closeModal();
    } catch (err) {
      console.error(err);
      alert('Something went wrong, but your request was recorded locally.');
      closeModal();
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Purchase Request';
    }
  });

  // Attach search listeners
  document.getElementById('market-search').addEventListener('input', fetchListings);
  document.getElementById('market-county').addEventListener('change', fetchListings);

  // Initialize
  fetchListings();
</script>
