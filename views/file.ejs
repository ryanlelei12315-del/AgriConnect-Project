<!-- AI CHATBOT -->
<button class="ai-fab" onclick="toggleAI()" title="AI Farm Assistant">🤖</button>

<div class="ai-panel" id="ai-panel">
  <div class="ai-head">🌾 AgriConnect AI Assistant</div>
  <div class="ai-msgs" id="ai-msgs">
    <div class="msg bot">Hi! I'm your farm assistant. Tell me what you need and I'll guide you. 👋</div>
  </div>
  <div class="ai-input-row">
    <input class="ai-input" id="ai-input" placeholder="e.g. I need irrigation help..." onkeydown="if(event.key==='Enter')sendAI()"/>
    <button class="ai-send" onclick="sendAI()">→</button>
  </div>
</div>

<script>
  function goTo(page) { window.location.href = page; }

  function toggleAI() {
    const p = document.getElementById('ai-panel');
    p.classList.toggle('open');
  }

  function sendAI() {
    const input = document.getElementById('ai-input');
    const text = input.value.trim();
    if (!text) return;
    addMsg(text, 'user');
    input.value = '';
    setTimeout(() => addMsg(respond(text), 'bot'), 500);
  }

  function addMsg(text, type) {
    const msgs = document.getElementById('ai-msgs');
    const d = document.createElement('div');
    d.className = 'msg ' + type;
    d.textContent = text;
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function respond(text) {
    text = text.toLowerCase();
    if (text.includes('irrigat') || text.includes('pump') || text.includes('water'))
      return '💧 Search "Irrigation Setup" in our Services section. Providers in Meru and Embu are available this week.';
    if (text.includes('transport') || text.includes('deliver') || text.includes('truck'))
      return '🚚 We have farm transport providers in Nakuru and Naivasha. Browse the Services page.';
    if (text.includes('sell') || text.includes('price') || text.includes('market'))
      return '📦 Go to the Marketplace and click "Post Produce". Set your own price — no broker needed!';
    if (text.includes('tractor') || text.includes('repair') || text.includes('machine'))
      return '🚜 Tractor repair services are listed in Eldoret/Uasin Gishu. View Services for contacts.';
    if (text.includes('buy') || text.includes('tomato') || text.includes('maize') || text.includes('potato'))
      return '🛒 Browse the Marketplace to find fresh produce from farmers across Kenya. Filter by county and price.';
    if (text.includes('register') || text.includes('join') || text.includes('sign up'))
      return '✅ Registration is free! Click "Join Free" in the top right. Choose your role: Farmer, Buyer, or Provider.';
    return '🌾 I can help with produce listings, service bookings, and getting started. What specifically do you need?';
  }
</script>

