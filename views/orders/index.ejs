<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="page-container">
  <div class="page-header">
    <div class="page-header-text">
      <span class="page-eyebrow">Transactions</span>
      <h1 class="page-title">My Orders</h1>
      <p class="page-subtitle"><%= isFarmer ? 'Orders placed by buyers for your produce listings.' : 'Purchase orders placed for farm produce.' %></p>
    </div>
    <div class="page-header-actions">
      <a href="/dashboard" class="btn btn-outline"><i data-lucide="arrow-left"></i> Back to Dashboard</a>
    </div>
  </div>

  <div class="card card-pad" style="padding:0; overflow:hidden;">
    <% if (orders && orders.length > 0) { %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Date</th>
              <th><%= isFarmer ? 'Buyer' : 'Seller' %></th>
              <th>Produce</th>
              <th>Quantity</th>
              <th>Total</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td class="cell-strong">#ORD-<%= o.id %></td>
                <td><%= new Date(o.createdAt).toLocaleDateString('en-KE', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                <td><%= isFarmer ? (o.buyer ? o.buyer.fullName : 'Buyer') : (o.seller ? o.seller.fullName : 'Seller') %></td>
                <td class="cell-strong">
                  <% if (o.items && o.items.length > 0 && o.items[0].listing) { %>
                    <%= o.items[0].listing.name %>
                  <% } else { %>
                    Produce Item
                  <% } %>
                </td>
                <td><%= o.items && o.items.length > 0 ? Number(o.items[0].quantityKg).toLocaleString() : 0 %> kg</td>
                <td class="cell-amount">KES <%= Number(o.totalKes).toLocaleString() %></td>
                <td>
                  <% const st = (o.status || 'pending').toLowerCase(); %>
                  <span class="badge <%= st === 'completed' ? 'badge-success' : st === 'pending' ? 'badge-warning' : st === 'canceled' ? 'badge-danger' : 'badge-info' %>">
                    <%= st %>
                  </span>
                </td>
                <td>
                  <a href="/orders/<%= o.id %>" class="btn btn-ghost btn-sm">View Details</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i data-lucide="shopping-bag"></i>
        <h3>No orders yet</h3>
        <p>
          <%= isFarmer ? 'When buyers place orders for your produce, they will appear here.' : 'When you order produce from farmers, your orders will appear here.' %>
        </p>
        <a href="/marketplace" class="btn btn-primary mt-1">Browse Marketplace</a>
      </div>
    <% } %>
  </div>
</main>

<script>
  if (window.lucide) lucide.createIcons();
</script>
<%- include('../partials/footer') %>
